# Секреты сервера. Скопируй в /srv/claude-api/data/server.env, chmod 600 (вне репо).
# Ключи НАШЕГО API через запятую. Клиент шлёт: x-api-key: <key>  (или Authorization: Bearer <key>).
# ПУСТО/нет файла — сервер принимает запросы ТОЛЬКО с 127.0.0.1.
CLAUDE_API_KEYS=put-a-long-random-key-here,another-key-for-second-client
# Read-only operational endpoints (/capacity, /metrics); production provisioning generates this.
CLAUDE_API_PANEL_KEY=put-a-separate-long-random-read-only-key-here
# Watchdog installer creates these once in production. Use independent random 64-hex values.
CLAUDE_API_REDIS_PASSWORD=replace-with-64-hex-redis-password
CLAUDE_API_REDIS_URL=redis://default:replace-with-64-hex-redis-password@127.0.0.1:6379/0
CLAUDE_API_AFFINITY_SECRET=put-an-independent-64-random-hex-secret-here
