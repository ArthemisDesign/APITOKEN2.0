# Секреты HTTP-сервера. Скопируй в /srv/claude-api/data/server.env, chmod 600.
# EnvironmentFile юнита claude-api-server.service подхватит это (вне репо).
# Ключи API через запятую. Клиент шлёт: Authorization: Bearer <key>  (или x-api-key: <key>).
# ПУСТО/файл отсутствует — сервер принимает запросы ТОЛЬКО с 127.0.0.1.
CLAUDE_API_KEYS=put-a-long-random-key-here,another-key-for-second-client
