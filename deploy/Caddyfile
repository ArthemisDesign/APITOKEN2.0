# Общий набор админов (bcrypt: Q/R/M/…) для панельных сайтов. Один placeholder, чтобы
# install-caddy.sh переносил учётки один раз, а vhost'ы подключали их через import.
(panel_admins) {
	basic_auth {
		<BASIC_AUTH_USERS_PLACEHOLDER>
	}
}

api.apitoken.sale {
	@public_core path /v1/* /health /balance
	handle @public_core {
		reverse_proxy 127.0.0.1:8787 127.0.0.1:8788 {
			lb_policy round_robin
			lb_try_duration 2s
			lb_try_interval 100ms

			health_uri /ready
			health_interval 2s
			health_timeout 2s
			health_status 2xx

			fail_duration 5s
			max_fails 1
			unhealthy_status 503
		}
	}
	respond 404
}

# Stable, loopback-only Control API origin for the commerce API and worker.
# Consumers never address an engine deployment slot directly.
http://127.0.0.1:8790 {
	bind 127.0.0.1

	reverse_proxy 127.0.0.1:8787 127.0.0.1:8788 {
		lb_policy round_robin
		lb_try_duration 2s
		lb_try_interval 100ms

		health_uri /ready
		health_interval 2s
		health_timeout 2s
		health_status 2xx

		fail_duration 5s
		max_fails 1
		unhealthy_status 503
	}
}

backend.apitoken.sale {
	reverse_proxy 127.0.0.1:3000 127.0.0.1:3001 {
		lb_policy round_robin
		lb_try_duration 3s
		lb_try_interval 100ms

		health_uri /v1/ready
		health_interval 2s
		health_timeout 2s
		health_status 2xx

		fail_duration 5s
		max_fails 1
		unhealthy_status 503
	}
}

mail.apitoken.sale, autodiscover.apitoken.sale, autoconfig.apitoken.sale {
	reverse_proxy 127.0.0.1:8080
}

panel.apitoken.sale {
	import panel_admins
	@data path /overview /capacity /metrics /subs
	handle @data {
		reverse_proxy 127.0.0.1:8787 127.0.0.1:8788 {
			lb_policy round_robin
			health_uri /ready
			health_interval 2s
			health_timeout 2s
			health_status 2xx
			fail_duration 5s
			max_fails 1
			unhealthy_status 503
			header_up x-api-key "<CONTROL_KEY_PLACEHOLDER>"
		}
	}
	# Вкладка «Пользователи»: commerce-обзор юзеров (backend /v1/admin/users). Секрет админки
	# инжектится server-side — в браузер не попадает; вход по-прежнему гейтится basic_auth выше.
	@users path /admin/users /admin/users/*
	handle @users {
		rewrite * /v1{uri}
		reverse_proxy 127.0.0.1:3000 127.0.0.1:3001 {
			lb_policy round_robin
			health_uri /v1/ready
			health_interval 2s
			health_timeout 2s
			health_status 2xx
			fail_duration 5s
			max_fails 1
			unhealthy_status 503
			header_up x-admin-key "<COMMERCIAL_ADMIN_KEY_PLACEHOLDER>"
		}
	}
	# Партнёрская админка вынесена на отдельный сайт partners.panel.apitoken.sale (см. ниже).
	# HTML панели отдаёт сам движок (GET /panel, вкомпилирован include_str!) — панель всегда
	# совпадает с задеплоенным релизом, никаких статических копий и ручного rsync.
	handle {
		rewrite * /panel
		reverse_proxy 127.0.0.1:8787 127.0.0.1:8788 {
			lb_policy round_robin
			health_uri /ready
			health_interval 2s
			health_timeout 2s
			health_status 2xx
			fail_duration 5s
			max_fails 1
			unhealthy_status 503
		}
	}
}

# Support console (Chatwoot) + Telegram webhook ingress. Chatwoot слушает 127.0.0.1:3010
# (порт 3000 занят commerce). Держим в деплой-шаблоне, чтобы каждый деплой НЕ ронял
# support-роут (иначе Telegram не может доставлять апдейты боту → поддержка «лежит»).
support.apitoken.sale {
	reverse_proxy 127.0.0.1:3010
}

# Stable, loopback-only commerce-backend origin for the sales bounded context.
# Health-gated across blue-green API slots so consumers never chase the active port.
http://127.0.0.1:8791 {
	bind 127.0.0.1

	reverse_proxy 127.0.0.1:3000 127.0.0.1:3001 {
		lb_policy round_robin
		lb_try_duration 2s
		lb_try_interval 100ms

		health_uri /v1/ready
		health_interval 2s
		health_timeout 2s
		health_status 2xx
		fail_duration 5s
		max_fails 1
		unhealthy_status 503
	}
}

# Партнёрский портал (APIToken Partners). Отдельный bounded context:
# /v1/* -> sales-api (:3100), остальное -> sales-web Next.js (:3200).
# Same-origin, чтобы кука sales_session оставалась first-party.
partners.apitoken.sale {
	# Внутренний контур (promo redeem и т.п.) не публикуем: commerce ходит на sales-api по
	# loopback :3100 напрямую, снаружи /v1/internal/* быть не должно.
	handle /v1/internal/* {
		respond 404
	}
	handle /v1/* {
		reverse_proxy 127.0.0.1:3100
	}
	handle {
		reverse_proxy 127.0.0.1:3200
	}
}

# Старый адрес партнёрки — постоянный редирект на partners.
sales.apitoken.sale {
	redir https://partners.apitoken.sale{uri} permanent
}

# Отдельный админ-сайт партнёрки. Вход — тот же basic_auth (Q/R/M), что и у панели.
# Caddy инжектит x-sales-admin-key на /v1/* server-side → страница /admin не просит ключ.
partners.panel.apitoken.sale {
	import panel_admins
	handle /v1/* {
		reverse_proxy 127.0.0.1:3100 {
			header_up x-sales-admin-key "<SALES_ADMIN_KEY_PLACEHOLDER>"
		}
	}
	handle / {
		redir * /admin
	}
	handle {
		reverse_proxy 127.0.0.1:3200
	}
}
