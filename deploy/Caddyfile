{
	# Clear client-supplied audit identity before forward_auth writes verified values. Caddy's
	# default order is the reverse, which would erase the copied identity after authentication.
	order request_header before forward_auth
	# The managed-auth snippet uses one order-preserving route so its successful cookie bridge and
	# credential cleanup run before any terminal site handle. The only other route is already nested
	# inside Gemini's OAuth callback handle, so this does not reorder an unrelated site boundary.
	order route before handle

	# RSA, not Caddy's default ECDSA. The native (Bun-based) Claude Code Windows build fails TLS
	# verification against Let's Encrypt ECDSA chains with UNKNOWN_CERTIFICATE_VERIFICATION_ERROR,
	# and no client-side workaround helps — not even NODE_EXTRA_CA_CERTS
	# (anthropics/claude-code#31777, #43967). Claude Code pointed at api.apitoken.sale is our
	# primary client, so every vhost must present the universally accepted RSA chain
	# (Let's Encrypt R intermediates → ISRG Root X1). Do not remove until those issues are fixed
	# and the fixed version is old enough that no customer runs an affected build.
	key_type rsa2048

	# The admin endpoint is loopback-only; Prometheus scrapes per-vhost request/latency metrics.
	metrics {
		per_host
	}

	# Requests traverse TWO Caddy hops (public vhost → loopback slot origin). Without this the
	# second hop discards the first hop's X-Forwarded-For and every backend sees 127.0.0.1 as the
	# client, blinding session audit and signup anti-fraud. Trust XFF only when the sender itself
	# is loopback (the first hop); internet clients can never spoof their way past it.
	servers {
		trusted_proxies static 127.0.0.1/8 ::1
	}

	# Runtime proxy errors include request headers. Redact every injected service credential so a
	# failed upstream can never copy an internal key into journald.
	log default {
		format filter {
			request>headers>Authorization replace REDACTED
			request>headers>Cookie replace REDACTED
			request>headers>X-Admin-Session-Set-Cookie replace REDACTED
			request>headers>X-Admin-Key replace REDACTED
			request>headers>X-Api-Key replace REDACTED
			request>headers>X-Proxy-Admin-Key replace REDACTED
			request>headers>X-Goog-Api-Key replace REDACTED
			request>headers>X-Sales-Admin-Key replace REDACTED
			request>headers>X-Crm-Ingest-Key replace REDACTED
			request>headers>X-Gemini-Oauth-Code replace REDACTED
			request>headers>X-Gemini-Oauth-Error replace REDACTED
			request>headers>X-Gemini-Oauth-State replace REDACTED
		}

		# Blue-green keeps exactly one slot of each pair stopped and disabled, but both slots stay
		# listed as upstreams so either can serve. The active health checker therefore polls a
		# deliberately dead address every 2s forever and logs a "connection refused" INFO line each
		# time — a steady 1 line/s that was 98% of everything matching the journal error panel and
		# ~44% of all journal lines. Drop the logger entirely; a stopped slot is expected state, and
		# a genuinely dead pair is caught by the ProxyUpstreamPairDown alert on
		# caddy_reverse_proxy_upstreams_healthy, which is a stronger signal than these lines were.
		exclude http.handlers.reverse_proxy.health_checker.active
	}
}

# Root-owned runtime state written only by deploy/router-promote.sh. It defines the single
# `router_backend` snippet used by both the public hostname and the stable loopback metrics origin.
# On the one-time migration it points at the legacy singleton; every later deploy alternates the
# verified 8800/8801 slots with an atomic Caddy reload.
import /etc/caddy/router-active.caddy

# Central database-backed admin authentication. The auth service checks the original hostname
# against each account's domain grants and returns a trusted actor identity for downstream audit.
# `forward_auth` copies successful auth-response headers onto the original request. The temporary
# cookie header is therefore bridged onto the browser response and removed again before an app can
# see it. Failed auth responses (401/303) are passed through by Caddy with their Location,
# X-Admin-Login and Set-Cookie headers intact.
(managed_admin_auth) {
	route {
		request_header -X-Admin-Actor
		request_header -X-Admin-Account-Id
		request_header -X-Admin-Auth-Mode
		request_header -X-Admin-Session-Set-Cookie
		@managed_admin_request not path /__admin-auth/*
		forward_auth @managed_admin_request 127.0.0.1:8791 {
			uri /v1/internal/admin-auth/verify
			header_up Host 127.0.0.1:8791
			header_up X-Admin-Key "<ADMIN_AUTH_KEY_PLACEHOLDER>"
			header_up X-Admin-Domain {http.request.host}
			header_up X-Admin-Auth-Mode session-v1
			header_up X-Forwarded-Method {http.request.method}
			header_up X-Forwarded-Uri {http.request.uri}
			header_up Sec-Fetch-Dest {http.request.header.Sec-Fetch-Dest}
			header_up Accept {http.request.header.Accept}
			header_down -WWW-Authenticate
			copy_headers X-Admin-Actor X-Admin-Account-Id Set-Cookie>X-Admin-Session-Set-Cookie
		}
		@admin_session_cookie header X-Admin-Session-Set-Cookie *
		header @admin_session_cookie +Set-Cookie {http.request.header.X-Admin-Session-Set-Cookie}
		request_header -X-Admin-Session-Set-Cookie
		request_header -Authorization
	}
}

# Same-origin browser login/logout is the only public projection of the internal auth controller.
# `handle_path` strips /__admin-auth before the exact internal browser prefix is restored.
(managed_admin_browser_auth) {
	handle_path /__admin-auth/* {
		rewrite * /v1/internal/admin-auth/browser{uri}
		reverse_proxy 127.0.0.1:8791 {
			header_up Host 127.0.0.1:8791
			header_up -X-Admin-Actor
			header_up -X-Admin-Account-Id
			header_up -X-Admin-Session-Set-Cookie
			header_up -X-Admin-Login
			header_up X-Admin-Key "<ADMIN_AUTH_KEY_PLACEHOLDER>"
			header_up X-Admin-Domain {http.request.host}
			header_up X-Admin-Auth-Mode session-v1
			header_down -WWW-Authenticate
		}
	}
}

# Execution groups and logical request IDs are reserved internal router→plane capabilities.
# Public clients can never choose or replay them: every provider hostname and the unified router
# erase all three headers at first ingress.
(strip_execution_identity) {
	request_header -X-Apitoken-Execution-Group
	request_header -X-Apitoken-Attempt
	request_header -X-Apitoken-Logical-Request-Id
}

# Streaming request-size cap for the four public model vhosts. This is the compile-time hard
# ceiling from crates/api-limits, not a raised public default: router and provider request caps
# remain the effective contract. Caddy enforces the cap on the incoming stream and does not
# buffer SSE responses.
(model_request_body) {
	request_body {
		max_size 256MiB
	}
}

# Every provider route targets its own stable loopback origin. Only those loopback sites know
# runtime ports; applications and public/admin vhosts never select a deployment slot themselves.
(engine_backend) {
	reverse_proxy 127.0.0.1:8790 {
		header_up Host 127.0.0.1:8790
		header_down -X-Apitoken-Execution-State
	}
}

# OpenAI has an independent process and stable origin. Provider selection is fixed at process
# startup; no request header can move traffic between runtimes.
(openai_engine_backend) {
	reverse_proxy 127.0.0.1:8792 {
		header_up Host 127.0.0.1:8792
		header_down -X-Apitoken-Execution-State
	}
}

# Gemini has its own fixed provider process and stable loopback origin. There is no request-level
# plane selector: only the dedicated public hostname can reach this runtime.
(gemini_engine_backend) {
	reverse_proxy 127.0.0.1:8794 {
		header_up Host 127.0.0.1:8794
		header_down -X-Apitoken-Execution-State
	}
}

# KIMI is backend-only: a fixed provider process and stable loopback origin with NO public vhost,
# no router namespace and no catalogue. The snippet exists for symmetry with the other planes;
# nothing public imports it, so it strips no internal execution header.
(kimi_engine_backend) {
	reverse_proxy 127.0.0.1:8803 {
		header_up Host 127.0.0.1:8803
	}
}

(commerce_backend) {
	reverse_proxy 127.0.0.1:8791 {
		header_up Host 127.0.0.1:8791
	}
}

# Admin-only commerce routes. The host-only key is injected by Caddy and never reaches a browser.
(commerce_admin_backend) {
	reverse_proxy 127.0.0.1:8791 {
		header_up Host 127.0.0.1:8791
		header_up x-admin-key "<COMMERCIAL_ADMIN_KEY_PLACEHOLDER>"
	}
}

# Admin-only sales routes. Shared by the central account dashboard and the unchanged partner
# admin application so the sales key exists only once in the rendered configuration.
(sales_admin_backend) {
	reverse_proxy 127.0.0.1:3100 {
		health_uri /v1/health
		health_interval 2s
		health_timeout 2s
		health_status 2xx
		header_up x-sales-admin-key "<SALES_ADMIN_KEY_PLACEHOLDER>"
	}
}

api.apitoken.sale {
	import strip_execution_identity
	import model_request_body
	@public_core path /v1/* /health /balance
	handle @public_core {
		import engine_backend
	}
	respond 404
}

openai.api.apitoken.sale {
	import strip_execution_identity
	import model_request_body
	# Compress only complete JSON documents. Responses SSE must stay identity-encoded so the
	# compressor cannot buffer small lifecycle frames and increase time-to-first-token.
	encode zstd gzip {
		minimum_length 512
		match {
			header Content-Type application/json*
		}
	}
	@public_core path /v1/* /health /balance
	handle @public_core {
		import openai_engine_backend
	}
	respond 404
}

gemini.api.apitoken.sale {
	import strip_execution_identity
	import model_request_body
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
	# OAuth callback belongs to authbot, not the provider runtime. It must be matched before the
	# public API allowlist. Move one-use values to redacted internal headers and erase the query
	# before proxying so a callback transport error cannot write the authorization code into logs.
	@oauth_callback path /oauth/callback
	# Defense in depth: the rewritten URI is already query-free, but callback requests are omitted
	# from access logs entirely so a future logging/handler-order change cannot retain code/state.
	log_skip @oauth_callback
	handle @oauth_callback {
		route {
			request_header X-Gemini-OAuth-Code {http.request.uri.query.code}
			request_header X-Gemini-OAuth-State {http.request.uri.query.state}
			request_header X-Gemini-OAuth-Error {http.request.uri.query.error}
			rewrite * /oauth/callback?
			reverse_proxy 127.0.0.1:8796 {
				header_up Host 127.0.0.1:8796
			}
		}
	}
	@public_core path /v1beta/* /upload/v1beta/* /health /balance
	handle @public_core {
		import gemini_engine_backend
	}
	respond 404
}

# Unified multi-provider entry point — stage 1b of docs/engine/UNIFIED_ROUTER.md. TLS terminates
# here; everything else lives in the active blue-green router slot selected by router_backend:
# path-shape routing to the three provider planes, the aggregated /v1/models catalog and
# lane-shaped errors. The planes keep authentication, billing, retry boundaries and streaming
# behavior behind their stable origins; nothing changes on the per-provider hostnames.
router.apitoken.sale {
	import strip_execution_identity
	import model_request_body
	@public_core path /v1/messages* /v1/responses* /v1/chat/completions /v1/images/* /v1/models* /v1beta/* /upload/v1beta/* /health /balance
	handle @public_core {
		import router_backend
	}
	# No encode policy on purpose: every lane must keep SSE identity-encoded end to end, and
	# no client requires compression on the unified hostname.
	respond 404
}

# Stable loopback-only router origin. Prometheus and production verification never need to discover
# the active slot and cannot accidentally scrape a draining predecessor.
http://127.0.0.1:8802 {
	bind 127.0.0.1
	import router_backend
}

# Stable, loopback-only Control API origin for the commerce API and worker.
# Consumers never address an engine deployment slot directly.
http://127.0.0.1:8790 {
	bind 127.0.0.1

	reverse_proxy 127.0.0.1:8787 127.0.0.1:8788 {
		lb_policy round_robin
		lb_try_duration 2s
		lb_try_interval 100ms

		health_uri /ready
		health_interval 2s
		health_timeout 2s
		health_status 2xx
	}
	# `handle_errors` sees only Caddy handler failures, not a runtime-produced HTTP 503. Therefore
	# this signal proves that no health-gated runtime accepted the request; router may safely try the
	# next explicit model. Public provider vhosts strip it in their outer reverse_proxy snippets.
	handle_errors 503 {
		header X-Apitoken-Execution-State not_started
		respond "No healthy Anthropic runtime is available." 503
	}
}

# Stable OpenAI origin over health-gated blue-green HTTP slots. Both slots may overlap because the
# authenticated homes are owned by the separate Unix-socket app-server cohort.
http://127.0.0.1:8792 {
	bind 127.0.0.1

	reverse_proxy 127.0.0.1:8793 127.0.0.1:8797 {
		lb_policy round_robin
		lb_try_duration 2s
		lb_try_interval 100ms

		health_uri /ready
		health_interval 2s
		health_timeout 2s
		health_status 2xx
	}
	handle_errors 503 {
		header X-Apitoken-Execution-State not_started
		respond "No healthy OpenAI runtime is available." 503
	}
}

# Stable native Gemini origin over active/passive blue-green slots. `first` prevents the two
# generations from round-robining the same OAuth roster while both are healthy: the preferred
# ready slot accepts new work, and the old slot keeps only its already-established streams.
http://127.0.0.1:8794 {
	bind 127.0.0.1

	reverse_proxy 127.0.0.1:8795 127.0.0.1:8799 {
		lb_policy first
		lb_try_duration 2s
		lb_try_interval 100ms

		health_uri /ready
		health_interval 2s
		health_timeout 2s
		health_status 2xx
	}
	handle_errors 503 {
		header X-Apitoken-Execution-State not_started
		respond "No healthy Gemini runtime is available." 503
	}
}

# Stable KIMI origin over active/passive blue-green slots, mirroring the Gemini policy: `first`
# keeps one preferred generation serving while both are healthy. Backend-only — no public hostname
# ever routes here; Prometheus scrapes it as the kimi provider target and the admin data route
# below reads /kimi-subs from it.
http://127.0.0.1:8803 {
	bind 127.0.0.1

	reverse_proxy 127.0.0.1:8804 127.0.0.1:8805 {
		lb_policy first
		lb_try_duration 2s
		lb_try_interval 100ms

		health_uri /ready
		health_interval 2s
		health_timeout 2s
		health_status 2xx
	}
	handle_errors 503 {
		header X-Apitoken-Execution-State not_started
		respond "No healthy KIMI runtime is available." 503
	}
}

