{
	# Clear client-supplied audit identity before forward_auth writes verified values. Caddy's
	# default order is the reverse, which would erase the copied identity after authentication.
	order request_header before forward_auth

	# RSA, not Caddy's default ECDSA. The native (Bun-based) Claude Code Windows build fails TLS
	# verification against Let's Encrypt ECDSA chains with UNKNOWN_CERTIFICATE_VERIFICATION_ERROR,
	# and no client-side workaround helps — not even NODE_EXTRA_CA_CERTS
	# (anthropics/claude-code#31777, #43967). Claude Code pointed at api.apitoken.sale is our
	# primary client, so every vhost must present the universally accepted RSA chain
	# (Let's Encrypt R intermediates → ISRG Root X1). Do not remove until those issues are fixed
	# and the fixed version is old enough that no customer runs an affected build.
	key_type rsa2048

	# The admin endpoint is loopback-only; Prometheus scrapes per-vhost request/latency metrics.
	metrics {
		per_host
	}

	# Requests traverse TWO Caddy hops (public vhost → loopback slot origin). Without this the
	# second hop discards the first hop's X-Forwarded-For and every backend sees 127.0.0.1 as the
	# client, blinding session audit and signup anti-fraud. Trust XFF only when the sender itself
	# is loopback (the first hop); internet clients can never spoof their way past it.
	servers {
		trusted_proxies static 127.0.0.1/8 ::1
	}

	# Runtime proxy errors include request headers. Redact every injected service credential so a
	# failed upstream can never copy an internal key into journald.
	log default {
		format filter {
			request>headers>X-Admin-Key replace REDACTED
			request>headers>X-Api-Key replace REDACTED
			request>headers>X-Goog-Api-Key replace REDACTED
			request>headers>X-Sales-Admin-Key replace REDACTED
			request>headers>X-Crm-Ingest-Key replace REDACTED
			request>headers>X-Gemini-Oauth-Code replace REDACTED
			request>headers>X-Gemini-Oauth-Error replace REDACTED
			request>headers>X-Gemini-Oauth-State replace REDACTED
		}

		# Blue-green keeps exactly one slot of each pair stopped and disabled, but both slots stay
		# listed as upstreams so either can serve. The active health checker therefore polls a
		# deliberately dead address every 2s forever and logs a "connection refused" INFO line each
		# time — a steady 1 line/s that was 98% of everything matching the journal error panel and
		# ~44% of all journal lines. Drop the logger entirely; a stopped slot is expected state, and
		# a genuinely dead pair is caught by the ProxyUpstreamPairDown alert on
		# caddy_reverse_proxy_upstreams_healthy, which is a stronger signal than these lines were.
		exclude http.handlers.reverse_proxy.health_checker.active
	}
}

# Central database-backed admin authentication. The auth service checks the original hostname
# against each account's domain grants and returns a trusted actor identity for downstream audit.
(managed_admin_auth) {
	request_header -X-Admin-Actor
	request_header -X-Admin-Account-Id
	forward_auth 127.0.0.1:8791 {
		uri /v1/internal/admin-auth/verify
		header_up Host 127.0.0.1:8791
		header_up X-Admin-Key "<ADMIN_AUTH_KEY_PLACEHOLDER>"
		header_up X-Admin-Domain {http.request.host}
		copy_headers X-Admin-Actor X-Admin-Account-Id
	}
}

# Every provider route targets its own stable loopback origin. Only those loopback sites know
# runtime ports; applications and public/admin vhosts never select a deployment slot themselves.
(engine_backend) {
	reverse_proxy 127.0.0.1:8790 {
		header_up Host 127.0.0.1:8790
	}
}

# OpenAI has an independent process and stable origin. Provider selection is fixed at process
# startup; no request header can move traffic between runtimes.
(openai_engine_backend) {
	reverse_proxy 127.0.0.1:8792 {
		header_up Host 127.0.0.1:8792
	}
}

# Gemini has its own fixed provider process and stable loopback origin. There is no request-level
# plane selector: only the dedicated public hostname can reach this runtime.
(gemini_engine_backend) {
	reverse_proxy 127.0.0.1:8794 {
		header_up Host 127.0.0.1:8794
	}
}

(commerce_backend) {
	reverse_proxy 127.0.0.1:8791 {
		header_up Host 127.0.0.1:8791
	}
}

# Admin-only commerce routes. The host-only key is injected by Caddy and never reaches a browser.
(commerce_admin_backend) {
	reverse_proxy 127.0.0.1:8791 {
		header_up Host 127.0.0.1:8791
		header_up x-admin-key "<COMMERCIAL_ADMIN_KEY_PLACEHOLDER>"
	}
}

# Admin-only sales routes. Shared by the central account dashboard and the unchanged partner
# admin application so the sales key exists only once in the rendered configuration.
(sales_admin_backend) {
	reverse_proxy 127.0.0.1:3100 {
		health_uri /v1/health
		health_interval 2s
		health_timeout 2s
		health_status 2xx
		header_up x-sales-admin-key "<SALES_ADMIN_KEY_PLACEHOLDER>"
	}
}

api.apitoken.sale {
	@public_core path /v1/* /health /balance
	handle @public_core {
		import engine_backend
	}
	respond 404
}

openai.api.apitoken.sale {
	# Compress only complete JSON documents. Responses SSE must stay identity-encoded so the
	# compressor cannot buffer small lifecycle frames and increase time-to-first-token.
	encode zstd gzip {
		minimum_length 512
		match {
			header Content-Type application/json*
		}
	}
	@public_core path /v1/* /health /balance
	handle @public_core {
		import openai_engine_backend
	}
	respond 404
}

gemini.api.apitoken.sale {
	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
	# OAuth callback belongs to authbot, not the provider runtime. It must be matched before the
	# public API allowlist. Move one-use values to redacted internal headers and erase the query
	# before proxying so a callback transport error cannot write the authorization code into logs.
	@oauth_callback path /oauth/callback
	# Defense in depth: the rewritten URI is already query-free, but callback requests are omitted
	# from access logs entirely so a future logging/handler-order change cannot retain code/state.
	log_skip @oauth_callback
	handle @oauth_callback {
		route {
			request_header X-Gemini-OAuth-Code {http.request.uri.query.code}
			request_header X-Gemini-OAuth-State {http.request.uri.query.state}
			request_header X-Gemini-OAuth-Error {http.request.uri.query.error}
			rewrite * /oauth/callback?
			reverse_proxy 127.0.0.1:8796 {
				header_up Host 127.0.0.1:8796
			}
		}
	}
	@public_core path /v1beta/* /health /balance
	handle @public_core {
		import gemini_engine_backend
	}
	respond 404
}

# Stable, loopback-only Control API origin for the commerce API and worker.
# Consumers never address an engine deployment slot directly.
http://127.0.0.1:8790 {
	bind 127.0.0.1

	reverse_proxy 127.0.0.1:8787 127.0.0.1:8788 {
		lb_policy round_robin
		lb_try_duration 2s
		lb_try_interval 100ms

		health_uri /ready
		health_interval 2s
		health_timeout 2s
		health_status 2xx
	}
}

# Stable OpenAI origin over health-gated blue-green HTTP slots. Both slots may overlap because the
# authenticated homes are owned by the separate Unix-socket app-server cohort.
http://127.0.0.1:8792 {
	bind 127.0.0.1

	reverse_proxy 127.0.0.1:8793 127.0.0.1:8797 {
		lb_policy round_robin
		lb_try_duration 2s
		lb_try_interval 100ms

		health_uri /ready
		health_interval 2s
		health_timeout 2s
		health_status 2xx
	}
}

# Stable native Gemini origin. The runtime is an independent singleton because its project pool,
# cooling and health lifecycle are a separate failure domain from Claude and OpenAI.
http://127.0.0.1:8794 {
	bind 127.0.0.1

	reverse_proxy 127.0.0.1:8795 {
		health_uri /ready
		health_interval 2s
		health_timeout 2s
		health_status 2xx
	}
}

backend.apitoken.sale {
	# Service-to-service endpoints are reachable only through the stable loopback origin.
	handle /v1/internal/* {
		respond 404
	}
	handle {
		import commerce_backend
	}
}

mail.apitoken.sale, autodiscover.apitoken.sale, autoconfig.apitoken.sale {
	reverse_proxy 127.0.0.1:8080
}

# Private editorial workspace. Human access and same-origin API calls share the panel admins;
# the commerce admin key stays server-side. The app also emits noindex headers as defence in depth.
content-studio.apitoken.sale {
	import managed_admin_auth
	handle /v1/* {
		import commerce_admin_backend
	}
	handle {
		reverse_proxy 127.0.0.1:3500
	}
}

# Private production telemetry. Grafana trusts only the actor header injected after the central
# managed-admin credential has been verified for this exact hostname.
monitoring.apitoken.sale {
	request_header -X-WEBAUTH-USER
	import managed_admin_auth
	reverse_proxy 127.0.0.1:3600 {
		header_up X-WEBAUTH-USER {http.request.header.X-Admin-Actor}
	}
}

# Unified administration site for commerce, engine capacity, partner accounts and CRM visibility.
admin.apitoken.sale {
	import managed_admin_auth
	encode zstd gzip
	# The panel JavaScript is served as a same-origin resource. This keeps the script policy strict
	# without a hash that has to be manually synchronized with every embedded panel change. Styles
	# remain inline because live utilization bars use bounded width values. Do not add unsafe-inline
	# for scripts.
	header {
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'unsafe-inline'; connect-src 'self'; img-src 'self' data:; font-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'self'; object-src 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		X-Robots-Tag "noindex, nofollow, noarchive"
	}
	@admin_panel_asset path /admin-panel.js
	handle @admin_panel_asset {
		import engine_backend
	}
	@admin_data path /overview /capacity /metrics /subs /spend-stats
	handle @admin_data {
		reverse_proxy 127.0.0.1:8790 {
			header_up Host 127.0.0.1:8790
			header_up x-api-key "<ADMIN_CONTROL_KEY_PLACEHOLDER>"
		}
	}
	# GPT-подписки живут в отдельном OpenAI-runtime: его operational status отдаёт только
	# стабильный OpenAI origin; на Anthropic-процессе /codex-subs вернул бы enabled:false.
	@admin_openai_data path /codex-subs
	handle @admin_openai_data {
		reverse_proxy 127.0.0.1:8792 {
			header_up Host 127.0.0.1:8792
			header_up x-api-key "<ADMIN_CONTROL_KEY_PLACEHOLDER>"
		}
	}
	# Gemini has its own fixed runtime and OAuth/profile lifecycle, so its sanitized fleet status is
	# read from the stable Gemini origin instead of either of the other provider processes.
	@admin_gemini_data path /gemini-subs
	handle @admin_gemini_data {
		reverse_proxy 127.0.0.1:8794 {
			header_up Host 127.0.0.1:8794
			header_up x-api-key "<ADMIN_CONTROL_KEY_PLACEHOLDER>"
		}
	}
	@commerce_admin path /admin/*
	handle @commerce_admin {
		rewrite * /v1{uri}
		reverse_proxy 127.0.0.1:8791 {
			header_up Host 127.0.0.1:8791
			header_up x-admin-key "<ADMIN_COMMERCIAL_KEY_PLACEHOLDER>"
		}
	}
	# OpenKeys owns batch labels and key-to-batch relationships. This path is reachable only
	# after managed_admin_auth; Caddy injects the server credential and the verified actor.
	handle_path /openkeys-admin/* {
		rewrite * /api/internal/admin{uri}
		reverse_proxy 127.0.0.1:3410 {
			header_up Host openkeys.apitoken.sale
			header_up X-OpenKeys-Control-Key "<OPENKEYS_INTERNAL_KEY_PLACEHOLDER>"
		}
	}
	handle_path /partner-admin/* {
		rewrite * /v1/admin{uri}
		import sales_admin_backend
	}
	handle {
		rewrite * /admin-panel
		import engine_backend
	}
}

# Support console (Chatwoot) + Telegram webhook ingress. Chatwoot слушает 127.0.0.1:3010
# (порт 3000 занят commerce). Держим в деплой-шаблоне, чтобы каждый деплой НЕ ронял
# support-роут (иначе Telegram не может доставлять апдейты боту → поддержка «лежит»).
support.apitoken.sale {
	reverse_proxy 127.0.0.1:3010
}

# Stable, loopback-only commerce-backend origin for the sales bounded context.
# Health-gated across blue-green API slots so consumers never chase the active port.
http://127.0.0.1:8791 {
	bind 127.0.0.1

	reverse_proxy 127.0.0.1:3000 127.0.0.1:3001 {
		lb_policy round_robin
		lb_try_duration 2s
		lb_try_interval 100ms

		health_uri /v1/ready
		health_interval 2s
		health_timeout 2s
		health_status 2xx
	}
}

# Партнёрский портал (APIToken Partners). Отдельный bounded context:
# /v1/* -> sales-api (:3100), остальное -> sales-web Next.js (:3200).
# Same-origin, чтобы кука sales_session оставалась first-party.
partners.apitoken.sale {
	# Внутренний контур (promo redeem и т.п.) не публикуем: commerce ходит на sales-api по
	# loopback :3100 напрямую, снаружи /v1/internal/* быть не должно.
	handle /v1/internal/* {
		respond 404
	}
	handle /v1/* {
		reverse_proxy 127.0.0.1:3100
	}
	handle {
		reverse_proxy 127.0.0.1:3200
	}
}

# Старый адрес партнёрки — постоянный редирект на partners.
sales.apitoken.sale {
	redir https://partners.apitoken.sale{uri} permanent
}

# OpenKeys — предоплаченные ключи без регистрации (продажа на FunPay и т.п.).
# Весь домен обслуживает одно Next.js-приложение (:3410): публичные доки,
# страницы расхода /u/* и собственная админка /admin с логином из openkeys.env.
# Basic-auth на уровне Caddy тут НЕ нужен: /admin закрыт логином приложения,
# а всё остальное обязано быть доступно покупателю без авторизации.
# Порт 3410, а НЕ 3400: 3400 занят crm-api (см. блок crm.apitoken.sale ниже).
openkeys.apitoken.sale {
	request_body {
		max_size 32KB
	}
	# The central-admin bridge is loopback-only through admin.apitoken.sale. Do not expose the
	# credential-gated handler on the public customer/admin hostname.
	handle /api/internal/* {
		respond 404
	}
	handle {
		reverse_proxy 127.0.0.1:3410
	}
}

crm.apitoken.sale {
	# Parser ingest bypasses human admin auth and remains protected by x-crm-ingest-key in crm-api.
	handle /v1/ingest/* {
		reverse_proxy 127.0.0.1:3400
	}
	# Public broadcast tracking-link redirect /r/<token> — NO admin auth (a cold Telegram recipient
	# clicks it). crm-api logs the per-recipient click and 302s to the landing with UTM. The token is
	# unguessable; the endpoint only records a click and redirects, so it is safe to expose publicly.
	handle /r/* {
		rewrite * /v1{uri}
		reverse_proxy 127.0.0.1:3400
	}
	handle /v1/* {
		import managed_admin_auth
		reverse_proxy 127.0.0.1:3400
	}
	handle {
		import managed_admin_auth
		reverse_proxy 127.0.0.1:3300
	}
}

# Separate partner admin application; content is unchanged and access is centrally domain-scoped.
# Caddy инжектит x-sales-admin-key на /v1/* server-side → страница /admin не просит ключ.
admin.partners.apitoken.sale {
	import managed_admin_auth
	handle /v1/* {
		import sales_admin_backend
	}
	handle / {
		redir * /admin
	}
	handle {
		reverse_proxy 127.0.0.1:3200
	}
}
