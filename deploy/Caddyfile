# Unified administration site for commerce, engine capacity, partner accounts and CRM visibility.
# The UI is the standalone Next.js app `apps/admin` on 127.0.0.1:3700 (own deploy lane); the
# engine only serves the data routes below; event feeds let the app invalidate them same-origin.
# The app sends its own security headers via next.config.ts; the two headers here are defence in
# depth that must not depend on the app release.
admin.apitoken.sale {
	import managed_admin_auth
	import managed_admin_browser_auth
	encode zstd gzip
	header {
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		X-Robots-Tag "noindex, nofollow, noarchive"
	}
	# /glm-subs stays on this same Anthropic origin: GLM is a backend inside the Anthropic
	# runtime, so unlike /codex-subs and /gemini-subs it needs no separate origin or key.
	@admin_data path /overview /capacity /metrics /subs /spend-stats /fleet-history /settlement-health /glm-subs /events/engine
	handle @admin_data {
		rewrite /events/engine /admin-events
		reverse_proxy 127.0.0.1:8790 {
			header_up Host 127.0.0.1:8790
			header_up x-api-key "<ADMIN_CONTROL_KEY_PLACEHOLDER>"
		}
	}
	# Proxy lifecycle is owned by authbot. Keep the URI intact, overwrite any client-supplied
	# credentials, and forward the verified actor. The shared x-api-key is rollback/mixed-version
	# compatibility for the old binary only; the new binary authenticates only X-Proxy-Admin-Key.
	handle /proxy-admin/* {
		reverse_proxy 127.0.0.1:8806 {
			header_up Host 127.0.0.1:8806
			header_up X-Proxy-Admin-Key "<AUTH_BOT_PROXY_ADMIN_KEY_PLACEHOLDER>"
			header_up x-api-key "<ADMIN_CONTROL_KEY_PLACEHOLDER>"
			header_up X-Admin-Actor {http.request.header.X-Admin-Actor}
		}
	}
	# GPT-подписки живут в отдельном OpenAI-runtime: его operational status отдаёт только
	# стабильный OpenAI origin; на Anthropic-процессе /codex-subs вернул бы enabled:false.
	@admin_openai_data path /codex-subs /events/openai
	handle @admin_openai_data {
		rewrite /events/openai /admin-events
		reverse_proxy 127.0.0.1:8792 {
			header_up Host 127.0.0.1:8792
			header_up x-api-key "<ADMIN_CONTROL_KEY_PLACEHOLDER>"
		}
	}
	# Gemini has its own fixed runtime and OAuth/profile lifecycle, so its sanitized fleet status is
	# read from the stable Gemini origin instead of either of the other provider processes. The
	# nested path is the operator switch (POST .../disabled), which pulls one profile out of
	# rotation; it rides the same origin and the same injected control key as the read.
	@admin_gemini_data path /gemini-subs /gemini-subs/* /events/gemini
	handle @admin_gemini_data {
		rewrite /events/gemini /admin-events
		reverse_proxy 127.0.0.1:8794 {
			header_up Host 127.0.0.1:8794
			header_up x-api-key "<ADMIN_CONTROL_KEY_PLACEHOLDER>"
		}
	}
	# KIMI now owns its runtime: the dedicated default-off plane serves the sanitized projection
	# from the stable loopback origin. The gateway embedded in the Anthropic runtime is dev/test
	# only, so /kimi-subs no longer lives on the Anthropic-origin matcher.
	@admin_kimi_data path /kimi-subs /events/kimi
	handle @admin_kimi_data {
		rewrite /events/kimi /admin-events
		reverse_proxy 127.0.0.1:8803 {
			header_up Host 127.0.0.1:8803
			header_up x-api-key "<ADMIN_CONTROL_KEY_PLACEHOLDER>"
		}
	}
	@commerce_admin path /admin/*
	handle @commerce_admin {
		rewrite * /v1{uri}
		reverse_proxy 127.0.0.1:8791 {
			header_up Host 127.0.0.1:8791
			header_up x-admin-key "<ADMIN_COMMERCIAL_KEY_PLACEHOLDER>"
		}
	}
	# OpenKeys owns batch labels and key-to-batch relationships. This path is reachable only
	# after managed_admin_auth; Caddy injects the server credential and the verified actor.
	handle_path /openkeys-admin/* {
		rewrite * /api/internal/admin{uri}
		reverse_proxy 127.0.0.1:3410 {
			header_up Host openkeys.apitoken.sale
			header_up X-OpenKeys-Control-Key "<OPENKEYS_INTERNAL_KEY_PLACEHOLDER>"
		}
	}
	handle_path /partner-admin/* {
		rewrite * /v1/admin{uri}
		import sales_admin_backend
	}
	handle {
		reverse_proxy 127.0.0.1:3700
	}
}

