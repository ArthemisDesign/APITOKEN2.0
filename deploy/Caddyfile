api.apitoken.sale {
	@public_core path /v1/* /health /balance
	handle @public_core {
		reverse_proxy 127.0.0.1:8787 127.0.0.1:8788 {
			lb_policy round_robin
			lb_try_duration 2s
			lb_try_interval 100ms

			health_uri /ready
			health_interval 2s
			health_timeout 2s
			health_status 2xx

			fail_duration 5s
			max_fails 1
			unhealthy_status 503
		}
	}
	respond 404
}

# Stable, loopback-only Control API origin for the commerce API and worker.
# Consumers never address an engine deployment slot directly.
http://127.0.0.1:8790 {
	reverse_proxy 127.0.0.1:8787 127.0.0.1:8788 {
		lb_policy round_robin
		lb_try_duration 2s
		lb_try_interval 100ms

		health_uri /ready
		health_interval 2s
		health_timeout 2s
		health_status 2xx

		fail_duration 5s
		max_fails 1
		unhealthy_status 503
	}
}

backend.apitoken.sale {
	reverse_proxy 127.0.0.1:3000 127.0.0.1:3001 {
		lb_policy round_robin
		lb_try_duration 3s
		lb_try_interval 100ms

		health_uri /v1/ready
		health_interval 2s
		health_timeout 2s
		health_status 2xx

		fail_duration 5s
		max_fails 1
		unhealthy_status 503
	}
}

mail.apitoken.sale, autodiscover.apitoken.sale, autoconfig.apitoken.sale {
	reverse_proxy 127.0.0.1:8080
}

panel.apitoken.sale {
	basic_auth {
		admin <BCRYPT_HASH_PLACEHOLDER>
	}
	@data path /overview /capacity /metrics /subs
	handle @data {
		reverse_proxy 127.0.0.1:8787 127.0.0.1:8788 {
			lb_policy round_robin
			health_uri /ready
			health_interval 2s
			health_timeout 2s
			health_status 2xx
			fail_duration 5s
			max_fails 1
			unhealthy_status 503
			header_up x-api-key "<CONTROL_KEY_PLACEHOLDER>"
		}
	}
	handle {
		root * /srv/claude-api/panel
		try_files {path} /index.html
		file_server
	}
}
