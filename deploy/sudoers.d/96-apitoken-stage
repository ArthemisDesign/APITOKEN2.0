# Staging identities have no production control. Only forced-command wrappers reach these helpers.
Cmnd_Alias APITOKEN_STAGE_OBSERVE = /usr/local/lib/apitoken-watchdog/stage-observe-helper.sh *
Cmnd_Alias APITOKEN_STAGE_REPORT = /usr/local/lib/apitoken-watchdog/stage/watchdog-github-stage commit-status *, \
    /usr/local/lib/apitoken-watchdog/stage/watchdog-github-stage deployment-create *, \
    /usr/local/lib/apitoken-watchdog/stage/watchdog-github-stage deployment-status *
Cmnd_Alias APITOKEN_STAGE_CTL = /usr/local/lib/apitoken-watchdog/stage-eligible-publish.sh [0-9a-f]* *, \
    /usr/local/lib/apitoken-watchdog/stage-ctl-helper.sh emergency-stop, \
    /usr/local/lib/apitoken-watchdog/stage-ctl-helper.sh attest, \
    /usr/local/lib/apitoken-watchdog/stage-promotion-helper.sh attest [0-9a-f]* *, \
    /usr/local/lib/apitoken-watchdog/stage-promotion-helper.sh sync [0-9a-f]*, \
    /usr/local/lib/apitoken-watchdog/stage-live-control.sh enable [0-9]* [0-9]* [A-Za-z0-9_.-]*, \
    /usr/local/lib/apitoken-watchdog/stage-live-control.sh probe [A-Za-z0-9._:-]* [A-Za-z0-9_.-]*, \
    /usr/local/lib/apitoken-watchdog/stage-live-control.sh disable [A-Za-z0-9_.-]*, \
    /usr/local/lib/apitoken-watchdog/stage-ctl-helper.sh reseed, \
    /usr/local/lib/apitoken-watchdog/stage-seed.sh reseed
observe-stage ALL=(root) NOPASSWD: APITOKEN_STAGE_OBSERVE
stage-ctl ALL=(root) NOPASSWD: APITOKEN_STAGE_CTL
deploy-stage ALL=(root) NOPASSWD: APITOKEN_STAGE_REPORT
observe-stage ALL=(ALL) !ALL
stage-ctl ALL=(ALL) !ALL
deploy-stage ALL=(ALL) !ALL
# Re-allow only the exact aliases after the deny-all last match.
observe-stage ALL=(root) NOPASSWD: APITOKEN_STAGE_OBSERVE
stage-ctl ALL=(root) NOPASSWD: APITOKEN_STAGE_CTL
deploy-stage ALL=(root) NOPASSWD: APITOKEN_STAGE_REPORT
