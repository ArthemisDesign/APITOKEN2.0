# Least-privilege sudo policy for the automatic deployment pipeline.
#
# Installed by deploy/install-sudoers.sh, which validates it with `visudo -c` before replacing the
# live file. Lexically ordered AFTER any legacy 90-deploy file so it wins on last-match.
#
# THREAT MODEL
# ------------
# The watchdog runs as `deploy` and executes candidate-derived build/test code (as the separate
# unprivileged `apitoken-ci` user). The design in docs/ops/DEPLOYMENT.md and deploy/README.md assumes
# `deploy` holds only narrowly scoped sudo. An unrestricted NOPASSWD:ALL voids that assumption: it
# lets the deploy operator read the GitHub reporting credential and every application secret in
# /etc/apitoken, and rewrite the root-owned controllers that are supposed to be fixed trust anchors.
#
# This policy grants exactly the operations the pipeline performs and nothing else. In particular
# `deploy` must NOT be able to read /etc/apitoken/*.env, write /usr/local/lib/apitoken-watchdog,
# or run an arbitrary interpreter as root.

Cmnd_Alias APITOKEN_HELPERS = \
    /usr/local/lib/apitoken-watchdog/watchdog-test-db, \
    /usr/local/lib/apitoken-watchdog/watchdog-test-db [A-Za-z-]*, \
    /usr/local/lib/apitoken-watchdog/watchdog-test-db [A-Za-z-]* [0-2], \
    /usr/local/lib/apitoken-watchdog/watchdog-backup.sh [0-9a-f]*, \
    /usr/local/lib/apitoken-watchdog/watchdog-migrate.sh [0-9a-f]*, \
    /usr/local/lib/apitoken-watchdog/watchdog-retention.sh [0-9]*, \
