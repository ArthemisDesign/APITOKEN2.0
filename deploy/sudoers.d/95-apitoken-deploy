# Candidate workspaces are built as apitoken-ci and finalized root-owned/read-only. The watchdog
# flips ownership and write bits around the test gate and removes expired trees. Restricted to the
# candidate root so this cannot be aimed at /etc or a release directory.
Cmnd_Alias APITOKEN_CANDIDATES = \
    /usr/bin/chown -R apitoken-ci\:apitoken-ci -- /var/lib/apitoken/watchdog/candidates/[0-9a-f]*, \
    /usr/bin/chown -R root\:root -- /var/lib/apitoken/watchdog/candidates/[0-9a-f]*, \
    /usr/bin/chmod -R a-w -- /var/lib/apitoken/watchdog/candidates/[0-9a-f]*, \
    /usr/bin/chmod -R u+w -- /var/lib/apitoken/watchdog/candidates/[0-9a-f]*, \
    /usr/bin/rm -rf --one-file-system -- /var/lib/apitoken/watchdog/candidates/[0-9a-f]*, \
    /usr/bin/rm -f -- /var/lib/apitoken/watchdog/[0-9a-f]*.tested

# Immutable release retention. Releases are finalized read-only, so write bits are restored before
# removal. Both roots are fixed; the trailing SHA pattern prevents aiming at a parent directory.
Cmnd_Alias APITOKEN_RELEASES = \
    /usr/bin/chmod -R u+w -- /srv/claude-api/releases/[0-9a-f]*, \
    /usr/bin/chmod -R u+w -- /opt/apitoken/releases/[0-9a-f]*, \
    /usr/bin/rm -rf --one-file-system -- /srv/claude-api/releases/[0-9a-f]*, \
    /usr/bin/rm -rf --one-file-system -- /opt/apitoken/releases/[0-9a-f]*

# Candidate build/test execution as the unprivileged CI account. The wildcard is deliberate: the
# test gate runs arbitrary package scripts from the candidate, and enumerating them is neither
# possible nor useful. It is safe because the target is `apitoken-ci`, NOT root — this is a
# de-escalation. `deploy` already outranks that account, so this grants no privilege it lacks; it
# only provides the clean environment the isolated build needs. See the (apitoken-ci) grant below.
Cmnd_Alias APITOKEN_CI = /usr/bin/env *

