# Read-only introspection. `show`/`is-*` reveal no secrets and are used by every readiness gate.
Cmnd_Alias APITOKEN_INSPECT = \
    /usr/bin/systemctl show *, \
    /usr/bin/systemctl is-active *, \
    /usr/bin/systemctl is-enabled *, \
    /usr/bin/systemctl is-failed *, \
    /usr/bin/systemctl list-units *, \
    /usr/bin/systemctl list-unit-files *, \
    /usr/bin/systemctl status *, \
    /usr/bin/systemctl list-timers *

# Operator tooling: `apitoken-watchdog status|run|retry|logs`. Reading the deployment journal is
# required for triage and exposes no secret, because neither the watchdog nor its helpers ever log
# credentials. Journal access is restricted to the pipeline's own units rather than granted wholesale.
# Policy self-management. Without this the change is one-way: once the unrestricted grant is gone,
# the deploy operator could no longer run the installer to update or repair its own policy, and
# recovery would require console access. The installer validates with `visudo -c`, keeps timestamped
# rollback copies, and restores the previous policy automatically if verification fails — so this is
# a narrower privilege than it appears. The installed installer is root-owned and not writable by
# deploy, and `install`/`cp` into the watchdog library remain denied below.
Cmnd_Alias APITOKEN_POLICY = \
    /usr/local/lib/apitoken-watchdog/install-sudoers.sh, \
    /usr/local/lib/apitoken-watchdog/install-sudoers.sh --check

Cmnd_Alias APITOKEN_OPERATOR = \
    /usr/local/bin/apitoken-watchdog, \
    /usr/local/bin/apitoken-watchdog status, \
    /usr/local/bin/apitoken-watchdog run, \
    /usr/local/bin/apitoken-watchdog logs, \
    /usr/local/bin/apitoken-watchdog retry [0-9a-f]*, \
    /usr/bin/systemctl start apitoken-deploy-watchdog.service, \
    /usr/bin/journalctl -u apitoken-deploy-watchdog.service *, \
    /usr/bin/journalctl -u apitoken-deploy-watchdog.service, \
    /usr/bin/journalctl -n [0-9]* -u apitoken-deploy-watchdog.service *, \
    /usr/bin/journalctl --no-pager -u apitoken-deploy-watchdog.service *

# Caddy config validation and reload during an infrastructure change.
Cmnd_Alias APITOKEN_CADDY = \
    /usr/bin/caddy validate --adapter caddyfile --config /etc/caddy/Caddyfile, \
    /usr/bin/grep -q * /etc/caddy/Caddyfile, \
    /usr/bin/test -s /etc/caddy/Caddyfile

