deploy ALL=(root) NOPASSWD: APITOKEN_HELPERS, APITOKEN_CANDIDATES, APITOKEN_RELEASES, \
    APITOKEN_UNITS, APITOKEN_INSPECT, APITOKEN_OPERATOR, APITOKEN_POLICY, APITOKEN_CADDY, \
    APITOKEN_PROBE
deploy ALL=(apitoken-ci) NOPASSWD: APITOKEN_CI

# Deny-list defence in depth. Even if a command spec above is later widened by accident, these
# must never be reachable: they would expose the GitHub reporting credential or application
# secrets, or let the deploy operator replace a fixed root-owned trust anchor.
deploy ALL=(ALL) !/usr/bin/cat /etc/apitoken/*, !/usr/bin/su, !/bin/su, \
    !/usr/bin/install * /usr/local/lib/apitoken-watchdog/*, \
    !/usr/bin/cp * /usr/local/lib/apitoken-watchdog/*
