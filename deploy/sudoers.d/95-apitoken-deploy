    /usr/local/lib/apitoken-watchdog/watchdog-infrastructure.sh [0-9a-f]* --controller-only, \
    /usr/local/lib/apitoken-watchdog/watchdog-infrastructure.sh [0-9a-f]* --caddy-only, \
    /usr/local/lib/apitoken-watchdog/watchdog-infrastructure.sh [0-9a-f]* --apply-caddy, \
    /usr/local/lib/apitoken-watchdog/controller/codex-homes-migrate.sh --apply, \
    /usr/local/lib/apitoken-watchdog/controller/engine-migrate.sh [0-9a-f]*, \
    /usr/local/lib/apitoken-watchdog/controller/authbot-runtime-state.sh [0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f], \
