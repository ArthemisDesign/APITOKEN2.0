# Telegram bot token (@BotFather), отдельный бот от партнёрского. ОБЯЗАТЕЛЬНО.
DEVBOT_TELEGRAM_TOKEN=123456789:REPLACE_ME
# id forum-группы (отрицательный, -100...). ОБЯЗАТЕЛЬНО.
DEVBOT_CHAT_ID=-1001234567890
# comma-separated numeric user id администраторов (user id, не username). ОБЯЗАТЕЛЬНО.
DEVBOT_ADMIN_IDS=111111111,222222222

# Thread id топиков — выдаёт scripts/provision-topics.mjs. ВСЕ ОБЯЗАТЕЛЬНЫ.
DEVBOT_TOPIC_CRITICAL=1
DEVBOT_TOPIC_DEPLOYS=2
DEVBOT_TOPIC_WARNINGS=3
DEVBOT_TOPIC_COMMERCE=4
DEVBOT_TOPIC_CI=5
DEVBOT_TOPIC_DIGEST=6

# Loopback-порт webhook/health/metrics сервера (bind 127.0.0.1).
DEVBOT_PORT=3800
# 128-битный секрет в пути webhook Alertmanager: POST /alerts/{DEVBOT_AM_SECRET}. ОБЯЗАТЕЛЬНО.
DEVBOT_AM_SECRET=REPLACE_ME_128_BIT_HEX

# Fine-grained PAT (read: commit statuses, deployments, metadata). Без него поллер выключен.
DEVBOT_GITHUB_TOKEN=
DEVBOT_GITHUB_REPO=3xcalibur-tech/Claude_API
DEVBOT_POLL_GITHUB_MS=45000
# IANA time zone для времени в сообщениях и ежедневного дайджеста.
DEVBOT_TIME_ZONE=Asia/Tbilisi

# Alertmanager API (для /status, /alerts, /silence).
DEVBOT_ALERTMANAGER_URL=http://127.0.0.1:9093

# Control API движка; без ключей /pool и /settlement отвечают «not configured».
DEVBOT_ENGINE_READONLY_KEY=
DEVBOT_ENGINE_CONTROL_KEY=
DEVBOT_ENGINE_BASE_URL=http://127.0.0.1:8790

# JSON state-файл (последний SHA, fingerprint-store, счётчики дайджеста).
DEVBOT_STATE_FILE=/var/lib/apitoken/devbot/state.json
# node-exporter textfile: heartbeat-метрика бота (пишется раз в 60 с).
DEVBOT_HEARTBEAT_FILE=/var/lib/apitoken/monitoring/textfile/devbot.prom

# Tail journalctl -f (этап 3): [watchdog]/[agent-merge]/[*-deploy] события.
DEVBOT_JOURNALD_ENABLED=false

# debug | info | warn | error
DEVBOT_LOG_LEVEL=info
