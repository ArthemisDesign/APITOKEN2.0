NODE_ENV=development
PORT=3000
HOST=127.0.0.1
DATABASE_URL=postgresql://commerce:commerce-local-only@127.0.0.1:5433/commerce
ENGINE_BASE_URL=http://127.0.0.1:8787
ENGINE_CONTROL_KEY=replace-with-control-key
ENGINE_TIMEOUT_MS=10000
PUBLIC_API_BASE_URL=https://backend.apitoken.sale
PUBLIC_APP_BASE_URL=https://apitoken.sale
MIN_TOPUP_USD=1
MAX_TOPUP_USD=10000
SESSION_TTL_SECONDS=604800
AUTH_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64url-value
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600
# Required: generate a unique high-entropy value of at least 32 characters.
COMMERCIAL_ADMIN_KEY=

# Google OpenID Connect (enable by setting all three values)
# GOOGLE_CLIENT_ID=replace-with-google-client-id
# GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# GOOGLE_REDIRECT_URI=https://backend.apitoken.sale/v1/auth/google/callback

# GitHub OAuth (enable by setting all three values)
# GITHUB_CLIENT_ID=replace-with-github-client-id
# GITHUB_CLIENT_SECRET=replace-with-github-client-secret
# GITHUB_REDIRECT_URI=https://backend.apitoken.sale/v1/auth/github/callback

# Cryptomus (enable by setting both values)
# CRYPTOMUS_MERCHANT_ID=00000000-0000-0000-0000-000000000000
# CRYPTOMUS_PAYMENT_API_KEY=replace-with-cryptomus-payment-api-key

# DigiSeller (enable by setting all four values)
# DIGISELLER_SELLER_ID=123456
# DIGISELLER_API_KEY=replace-with-digiseller-api-key
# DIGISELLER_PRODUCT_ID=1234567
# DIGISELLER_CHECKOUT_TRACKING_SECRET=replace-with-at-least-32-random-characters
