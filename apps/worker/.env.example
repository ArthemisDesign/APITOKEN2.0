NODE_ENV=development
DATABASE_URL=postgresql://commerce:commerce-local-only@127.0.0.1:5433/commerce
ENGINE_BASE_URL=http://127.0.0.1:8790
ENGINE_CONTROL_KEY=replace-with-control-key
ENGINE_TIMEOUT_MS=10000
# Stage 8/9 authority revalidation. OPENKEYS_CONTROL_KEY defaults to ENGINE_CONTROL_KEY.
OPENKEYS_INTERNAL_BASE_URL=http://127.0.0.1:3410
# OPENKEYS_CONTROL_KEY=replace-with-dedicated-openkeys-control-key
CREDIT_POLL_MS=1000
PRICING_POLL_MS=60000
PRICING_CLOSE_GRACE_MS=3600000
FUNDING_NORMALIZATION_POLL_MS=5000
FUNDING_NORMALIZATION_BATCH_SIZE=25
FUNDING_NORMALIZATION_INVENTORY_PAGE_SIZE=500
FUNDING_NORMALIZATION_LEASE_MS=300000
FUNDING_NORMALIZATION_RETRY_MS=15000
STAGE8_CAPTURE_POLL_MS=5000
STAGE8_CAPTURE_LEASE_MS=300000
STAGE8_CAPTURE_RETRY_MS=15000
STAGE8_CAPTURE_MAX_ATTEMPTS=10
EMAIL_DELIVERY_MODE=disabled
EMAIL_POLL_MS=1000
AUTH_TOKEN_ENCRYPTION_KEY=replace-with-same-32-byte-base64url-value-as-api
PUBLIC_APP_BASE_URL=https://apitoken.sale
PUBLIC_API_BASE_URL=https://backend.apitoken.sale
# Platega reconcile poller — credits confirmed checkouts the webhook missed (same X-MerchantId/X-Secret as the API).
# PLATEGA_MERCHANT_ID=00000000-0000-0000-0000-000000000000
# PLATEGA_SECRET=replace-with-platega-x-secret
# PLATEGA_API_BASE_URL=https://app.platega.io
# PLATEGA_RECONCILE_MS=30000
# PLATEGA_RECONCILE_MIN_AGE_S=15
# EMAIL_FROM=no-reply@apitoken.sale
# Brevo uses STARTTLS on port 587. Production refuses delivery if the TLS upgrade fails.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USERNAME=replace-with-brevo-smtp-login
# SMTP_PASSWORD=replace-with-brevo-smtp-key
