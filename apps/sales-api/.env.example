# apps/sales-api — sales/referral partner portal backend
# Copy to .env (never commit real values).

# --- runtime ---
# development | test | production
NODE_ENV=development
# HTTP bind address and port (dev default 3100)
HOST=127.0.0.1
PORT=3100
# Graceful shutdown failsafe: force-exit after this many ms once SIGTERM/SIGINT arrives
API_DRAIN_DEADLINE_MS=25000

# --- sales database (own PostgreSQL, NOT the commerce database) ---
SALES_DATABASE_URL=postgres://sales:sales@127.0.0.1:5432/sales

# --- secrets ---
# 32-byte base64url key (43 chars) for AES-256-GCM encryption of raw auth tokens in the email outbox.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SALES_TOKEN_ENCRYPTION_KEY=
# Admin key for /v1/admin/* (header x-admin-key), min 32 chars
SALES_ADMIN_KEY=
# Key for the commerce internal feed (sent as x-api-key), min 32 chars
SALES_CONTROL_KEY=

# --- sessions ---
# Partner session TTL in seconds (default 30 days)
SALES_SESSION_TTL_SECONDS=2592000
# In-process TTL of resolved-session cache in seconds (default 30; 0 disables). Logout
# invalidates immediately; admin suspension propagates within this TTL.
# SALES_SESSION_CACHE_TTL_SECONDS=30

# --- telegram login (the only sign-in method) ---
# Create a bot via @BotFather, then bind the site domain: /setdomain -> partners.apitoken.sale.
# While unset, /v1/auth/telegram* responds 503 and the site shows "sign-in unavailable".
TELEGRAM_BOT_TOKEN=
# Bot username WITHOUT @ (e.g. apitoken_partners_bot)
TELEGRAM_BOT_USERNAME=

# --- commerce feed sync ---
# Origin of the commerce backend exposing /v1/internal/sales/* feeds
COMMERCE_BASE_URL=http://127.0.0.1:8791
# Poll interval for the attribution/usage/topup feeds
SYNC_INTERVAL_MS=60000
# Approved partner B2B requests are delivered to Commerce by a fenced durable effect loop.
PARTNER_EFFECT_POLL_INTERVAL_MS=1000
# A unique attempt token fences acknowledgements; stale claims are recovered after this lease.
PARTNER_EFFECT_LEASE_SECONDS=60

# --- public URLs ---
# Partner portal frontend (verify/reset links, invite URLs)
PUBLIC_SALES_BASE_URL=https://partners.apitoken.sale
# Main client site (referral URLs: <site>/register?ref=CODE)
PUBLIC_MAIN_SITE_URL=https://apitoken.sale

# --- commissions ---
# Default level-0 commission for new partners, basis points (1000 = 10%)
DEFAULT_COMMISSION_BPS=1000
# Default override commission earned from sub-partners, basis points
DEFAULT_SUB_COMMISSION_BPS=1000
# Минимальный профит за окно выплат в USD (меньше — роллится в следующий период)
SALES_MIN_PAYOUT_USD=0

# --- automated on-chain payouts: BSC mainnet USDT only ---
# Key and send RPC are an all-or-nothing pair. Empty both to keep the payout engine disabled.
PAYOUT_HOT_WALLET_KEY=
PAYOUT_SEND_RPC_URL=
# Comma-separated HTTP(S) read RPC fallback list.
PAYOUT_READ_RPC_URLS=https://bsc-dataseed.binance.org,https://bsc.publicnode.com
# These are pinned and validated at startup/admission; alternatives are rejected.
PAYOUT_CHAIN_ID=56
PAYOUT_USDT_CONTRACT=0x55d398326f99059fF775485246999027B3197955
# Exact decimal gwei, >0 and <=100. No float money calculation is used.
PAYOUT_GAS_PRICE_GWEI=0.05
PAYOUT_CONFIRMATIONS=3
# Production default: irreversible sends only inside the configured 3-day period window.
PAYOUT_ENFORCE_WINDOW=true

# --- email delivery (in-process outbox loop) ---
# log = render + log metadata only (dev); smtp = deliver via SMTP (required in production)
EMAIL_DELIVERY_MODE=log
# Outbox poll interval
EMAIL_POLL_INTERVAL_MS=5000
# Sender address (required for smtp mode)
EMAIL_FROM=
# SMTP transport (required for smtp mode)
SMTP_HOST=
SMTP_PORT=465
# true = implicit TLS; false = STARTTLS (TLS still enforced in production)
SMTP_SECURE=true
# Optional SMTP auth (must be set together)
SMTP_USERNAME=
SMTP_PASSWORD=

# --- auth token TTLs ---
EMAIL_VERIFICATION_TTL_SECONDS=86400
PASSWORD_RESET_TTL_SECONDS=3600
