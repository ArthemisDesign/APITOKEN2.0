NEXT_PUBLIC_BACKEND_URL=https://backend.apitoken.sale/v1
# Optional: point every Docs link to a separately deployed documentation portal.
# Without it, the standalone portal is served from /docs in this deployment.
NEXT_PUBLIC_DOCS_URL=/docs

# Optional search-engine ownership tokens. Values are emitted as verification meta tags at build time.
GOOGLE_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
