# claude-api — конфиг по умолчанию. Скопируй в $SUB_CFG_DIR/config.env
SUB_CFG_DIR=/srv/claude-api/data                 # свой реестр пула (копия текущего)
CLAUDE_BIN=/srv/agents/.local/bin/claude         # путь к CLI claude
CLAUDE_API_MODEL=claude-opus-4-8                  # дефолт-модель (Opus 4.8, с раздумьями)
# CLAUDE_API_USAGE_LOG=/srv/claude-api/data/usage.log

# ── HTTP-сервер (bin/claude-api-server, server/app.py) ──────────────────────
# CLAUDE_API_HOST=0.0.0.0                         # интерфейс прослушки
# CLAUDE_API_PORT=8787                            # порт
# CLAUDE_API_KEYS=key1,key2                       # ключи API; ПУСТО = только с 127.0.0.1
# CLAUDE_API_MAX_TRIES=3                          # попыток ротации при 429/лимите
# CLAUDE_API_TIMEOUT=600                          # таймаут одного хода, сек
# ── распределение / пул-селектор (lib/pool.py) ──────────────────────────────
# SUBS_FLEET=prod                                 # брать подписки только этого флота (пусто=все)
# CLAUDE_API_POLL=1                               # фоновый поллер лимитов (0 = выкл)
# CLAUDE_API_UTIL_CAP=0.95                        # клиентский потолок утилизации окна
# CLAUDE_API_COOL_SECS=300                        # cooling при 429 без известного reset
