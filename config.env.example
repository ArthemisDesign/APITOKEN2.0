# claude-api — конфиг. Скопируй в $SUB_CFG_DIR/config.env (юнит грузит через EnvironmentFile).
SUB_CFG_DIR=/srv/claude-api/data              # каталог реестра (subscriptions.db тут же)
# SUBS_DB=/srv/claude-api/data/subscriptions.db  # явный путь к БД (иначе $SUB_CFG_DIR/subscriptions.db)
# Stage 2 production DSN lives in root-only engine-postgres.env, not this committed template:
# CLAUDE_API_DATABASE_URL=postgresql://claude_engine:<secret>@127.0.0.1:5433/claude_engine
# CLAUDE_API_INSTANCE_ID=engine-host-slot       # optional stable slot identity; epoch still changes per start
# CLAUDE_API_PROVIDER=combined                   # bridge only while one process serves both domains

# ── HTTP-сервер ─────────────────────────────────────────────────────────────
CLAUDE_API_HOST=0.0.0.0
CLAUDE_API_PORT=8787
# CLAUDE_API_KEYS=key1,key2                    # ключи нашего API; ПУСТО = только с 127.0.0.1 (в server.env!)
# CLAUDE_API_UPSTREAM=https://api.anthropic.com

# ── пул / ротация ───────────────────────────────────────────────────────────
# SUBS_FLEET=prod                              # брать подписки только этого флота (all/пусто = любые)
# CLAUDE_API_MAX_TRIES=3                        # бюджет BACKEND-фейлов (5xx/сеть) на запрос; ошибки
#   подписки (429/401/403) бюджет НЕ тратят — крутимся по всему флоту, клиенту такая ошибка не идёт
# CLAUDE_API_MAX_INFLIGHT=6                     # мягкий Claude spill/load threshold, НЕ admission cap
# Client concurrency не имеет локального wait/reject-потолка: все запросы сразу идут в обработку.
# In-flight используется только для распределения нагрузки; provider quota возвращает честный 429.
# CLAUDE_API_UTIL_CAP=0.95                      # legacy-поле для /pool (роутинг рулит запасом ниже)
# CLAUDE_API_RESERVE_5H=0.10                    # запас 5h-окна (бережём 10% — меньше 429, не максим квоту)
# CLAUDE_API_RESERVE_7D=0.03                    # запас 7d-окна (бережём 3%)
# CLAUDE_API_RESERVE_JITTER=0.02                # ± разброс порога по подпискам (флот не режется на одном %)
# CLAUDE_API_COOL_SECS=300                      # cooling при 429 без известного reset
# CLAUDE_API_POLL=1                             # фоновый поллер лимитов (0 = выкл)

# ── аварийный ClaudeStore fallback (строго opt-in) ─────────────────────────
# Только fixed Anthropic/Combined plane и только metered POST /v1/messages. Локальная ротация и
# smooth-wait всегда выполняются первыми; внешний attempt один и только до первого публичного байта.
# Secret лежит отдельно в root-owned server.env; enabled без валидного sk-cs4 ключа не стартует.
# CLAUDE_API_CLAUDESTORE_FALLBACK_ENABLED=0

# ── автоматическая cache-affinity ──────────────────────────────────────────
# Клиенту НЕ нужен session_id: native harness headers и канонические префиксы истории определяются
# автоматически. Local L1 работает всегда; CLAUDE_API_AFFINITY_REDIS_URL из server.env включает
# общий L2 (при его отсутствии — fallback на CLAUDE_API_REDIS_URL). Это ОТДЕЛЬНЫЙ Redis-инстанс от
# Codex response history: maxmemory и maxmemory-policy в Redis задаются на инстанс, поэтому только
# так у двух потребителей независимые бюджеты и вытеснение. Affinity теряется безопасно (падает
# лишь prompt-cache hit rate), history — нет.
# CLAUDE_API_AFFINITY_TTL_SECS=3600             # срок общей привязки (покрывает prompt-cache)
# CLAUDE_API_AFFINITY_LOCAL_TTL_SECS=300        # быстрый per-process L1
# CLAUDE_API_AFFINITY_REDIS_TIMEOUT_MS=35       # короткий fail-open бюджет Redis

# ── прикладной слой Claude Code (обычно НЕ трогать вручную) ─────────────────
# Эти значения держатся АКТУАЛЬНЫМИ автоматически: tools/refresh-fingerprint.sh
# (таймер claude-api-fingerprint) снимает их с ЖИВОГО claude CLI и пишет сюда —
# чтобы не протухали при обновлениях Claude Code. Дефолты в коде — лишь fallback.
# CLAUDE_API_INJECT_IDENTITY=1                  # инжект Claude Code identity в system (нужно OAuth-токенам)
# CLAUDE_API_BETA=oauth-2025-04-20              # oauth-бета (обязательна); авто-обновляется
# CLAUDE_API_ANTHROPIC_VERSION=2023-06-01
# CLAUDE_API_UA=claude-cli/2.1.195 (external, sdk-cli)   # авто-обновляется; можно СПИСКОМ через
#   запятую (пул реальных UA) — тогда каждая персона пинит свой (антифингерпринт флота)
# CLAUDE_API_UA_SPREAD=8    # если UA один: разброс patch-версии между персонами (0/1 = выключить)
# CLAUDE_API_IDENTITY=You are a Claude agent, built on Anthropic's Claude Agent SDK.  # авто-обновляется

# ── optional native Codex provider / OpenAI-compatible text subset ───────────
# Выключено по умолчанию. Провайдер ходит на нативный ChatGPT Codex backend
# (chatgpt.com/backend-api/codex) по образцу Gemini-провайдера: пул sealed OAuth-профилей,
# никаких дочерних процессов. Runbook: docs/engine/CODEX_PROVIDER.md.
# Это SDK-compatible subset, не OpenAI Platform API.
# CLAUDE_API_CODEX_ENABLED=0
# Roster запечатанных профилей: profiles.json рядом с credentials/<id>.json. Authbot
# републикует его атомарно; движок пересканирует на каждом health-тике без рестарта.
# CLAUDE_API_CODEX_PROFILES_FILE=/srv/claude-api/data/codex/profiles.json
# Keyring, открывающий AEAD-конверты профилей (kid:64-hex[,...]). Тот же, что у authbot
# (AUTH_BOT_CODEX_CREDENTIAL_KEYS) — иначе движок не откроет купленные аккаунты.
# CLAUDE_API_CODEX_CREDENTIAL_KEYS=current:<64 hex>
# Нативный backend и wire-идентичность официального клиента (версия движется только
# reviewed-коммитом после live probe — research/CODEX_NATIVE_WIRE.md).
# CLAUDE_API_CODEX_BASE_URL=https://chatgpt.com/backend-api/codex
# CLAUDE_API_CODEX_CLI_VERSION=0.146.0
# CLAUDE_API_CODEX_MODELS=gpt-5.6,gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna,gpt-5.5,gpt-5.4
# Как часто фоновый цикл перечитывает /wham/usage каждого профиля и каталог roster.
# 10с согласовано с автообновлением страницы подписок в админ-панели.
# CLAUDE_API_CODEX_HEALTH_INTERVAL_SECS=10
# Мягкий запас окон на профиль: не роутим выше ~98% короткого окна (у GPT сейчас фактически
# только недельный лимит) и ~97% недельного; порог джиттерится по профилю (антифингерпринт).
# CLAUDE_API_CODEX_RESERVE_5H=0.02
# CLAUDE_API_CODEX_RESERVE_7D=0.03
# CLAUDE_API_CODEX_RESERVE_JITTER=0.02
# CLAUDE_API_CODEX_REQUEST_TIMEOUT_MS=15000
# CLAUDE_API_CODEX_TURN_TIMEOUT_MS=600000  # hard max 600000; deploy drain deadline may cancel earlier
# CLAUDE_API_CODEX_TURN_SILENCE_TIMEOUT_MS=180000
# CLAUDE_API_CODEX_RESERVE_OVERHEAD_TOKENS=16384
# CLAUDE_API_CODEX_HISTORY_TTL_SECS=86400
# CLAUDE_API_CODEX_HISTORY_LOCAL_CAP=10000
# CLAUDE_API_CODEX_HISTORY_REDIS_TIMEOUT_MS=1000
# Если CLAUDE_API_REDIS_URL включён, общий Codex history шифруется CLAUDE_API_AFFINITY_SECRET;
# без секрета Codex provider не стартует. History остаётся на 6379 вместе со своими сохранёнными
# разговорами; на отдельный инстанс переехал affinity (см. выше), потому что его потеря безопасна.
# Персональный прокси профиля зашит в его envelope; общесистемные HTTP(S)_PROXY не наследуются.

# ── аварийный ClaudeStore GPT fallback (строго opt-in) ────────────────────
# Только fixed OpenAI/Combined plane, только официально заявленные gpt-5.5 и gpt-5.4 и максимум
# один POST /v1/responses после terminal результата штатной local Codex-ротации. Нужен ОТДЕЛЬНЫЙ
# sk-cs4 ключ, переключённый в ClaudeStore на tier Codex: Basic/Claude key сюда не подходит и не
# должен переиспользоваться. Secret лежит в root-owned server.env. Без enable+secret трафика нет.
# CLAUDE_API_CLAUDESTORE_CODEX_FALLBACK_ENABLED=0

# ── native Gemini surface / отдельный encrypted OAuth subscription pool ────
# Работает только в Gemini fixed-provider units с CLAUDE_API_PROVIDER=gemini; production использует
# active/passive claude-api-gemini@8795/8799, а legacy singleton — только для старого rollback.
# CLAUDE_API_GEMINI_PROFILES_FILE=/srv/claude-api/data/gemini/profiles.json
# CLAUDE_API_GEMINI_CREDENTIAL_KEYS=current:<64-hex>[,old:<64-hex>]
# CLAUDE_API_GEMINI_MODELS=gemini-3.1-flash-image,gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-3.1-pro-preview,gemini-3.1-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite
# CLAUDE_API_GEMINI_UPSTREAM=https://daily-cloudcode-pa.sandbox.googleapis.com
# CLAUDE_API_GEMINI_ALLOW_INSECURE_LOOPBACK_UPSTREAM=0  # только literal loopback mock
# Production unit pins these four together after shared env files; changing one requires a fresh
# Antigravity wire review and transport attestation.
# CLAUDE_API_GEMINI_ANTIGRAVITY_VERSION=2.2.1
# CLAUDE_API_GEMINI_NODE_BINARY=/usr/bin/node
# CLAUDE_API_GEMINI_NODE_VERSION=v24.18.0
# CLAUDE_API_GEMINI_NODE_SHA256=41a74efb34cbde5c7632cdac0cf8bd1a14d0b8d73dc1e82755014d9a9ce70f5c
# CLAUDE_API_GEMINI_CONNECT_TIMEOUT_SECS=30
# CLAUDE_API_GEMINI_READ_TIMEOUT_SECS=120
# CLAUDE_API_GEMINI_MAX_TRANSPORT_RETRIES=1
# CLAUDE_API_GEMINI_AUTH_QUARANTINE_SECS=900
# CLAUDE_API_GEMINI_TRANSPORT_COOL_SECS=5
# CLAUDE_API_GEMINI_RATE_LIMIT_COOL_SECS=60
# CLAUDE_API_GEMINI_HEALTH_INTERVAL_SECS=300
# CLAUDE_API_GEMINI_RESERVE_OVERHEAD_TOKENS=8192

# ── backend-only KIMI plane / encrypted paid subscription pool ─────────────
# Строго default-off и только в KIMI fixed-provider units с CLAUDE_API_PROVIDER=kimi; production
# обслуживает KIMI только из active/passive claude-api-kimi@8804/8805 за стабильным loopback
# origin 127.0.0.1:8803 (публичного vhost и router-namespace нет). Оба юнита argv-level пинят
# CLAUDE_API_KIMI_ENABLED=0, поэтому значения ниже из общего config.env НЕ могут молча включить
# плоскость: включение — отдельное reviewed изменение юнита после live evidence
# (docs/engine/KIMI_PROVIDER.md). Disabled-плоскость игнорирует dormant значения; enabled fail-closed
# требует абсолютный roster, keyring, HTTPS base URL, известную auth-схему и положительный poll.
# Anthropic-плоскость держит KIMI выключенным, чтобы ровно один процесс вёл maintenance writer.
# CLAUDE_API_KIMI_ENABLED=0
# CLAUDE_API_KIMI_ROSTER_DIR=/srv/claude-api/data/kimi
# Keyring, открывающий AEAD-конверты профилей (kid:64-hex[,...]). Тот же, что у authbot —
# иначе движок не откроет купленные аккаунты. Секрет живёт в root-owned server.env.
# CLAUDE_API_KIMI_CREDENTIAL_KEYS=current:<64-hex>[,old:<64-hex>]
# CLAUDE_API_KIMI_BASE_URL=https://api.kimi.com/coding/v1
# CLAUDE_API_KIMI_AUTH_SCHEME=bearer
# Как часто maintenance loop запускает бесплатный /usages sweep каждого профиля.
# CLAUDE_API_KIMI_QUOTA_POLL_SECS=300
