# claude-api — конфиг по умолчанию. Скопируй в $SUB_CFG_DIR/config.env
SUB_CFG_DIR=/srv/claude-api/data                 # свой реестр пула (копия текущего)
CLAUDE_BIN=/srv/agents/.local/bin/claude         # путь к CLI claude
CLAUDE_API_MODEL=claude-opus-4-8                  # дефолт-модель (Opus 4.8, с раздумьями)
# CLAUDE_API_USAGE_LOG=/srv/claude-api/data/usage.log
