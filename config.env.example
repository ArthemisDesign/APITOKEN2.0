# claude-api — конфиг. Скопируй в $SUB_CFG_DIR/config.env (юнит грузит через EnvironmentFile).
SUB_CFG_DIR=/srv/claude-api/data              # каталог реестра (subscriptions.db тут же)
# SUBS_DB=/srv/claude-api/data/subscriptions.db  # явный путь к БД (иначе $SUB_CFG_DIR/subscriptions.db)
# Stage 2 production DSN lives in root-only engine-postgres.env, not this committed template:
# CLAUDE_API_DATABASE_URL=postgresql://claude_engine:<secret>@127.0.0.1:5433/claude_engine
# CLAUDE_API_INSTANCE_ID=engine-host-slot       # optional stable slot identity; epoch still changes per start
# CLAUDE_API_PROVIDER=combined                   # bridge only while one process serves both domains

# ── HTTP-сервер ─────────────────────────────────────────────────────────────
CLAUDE_API_HOST=0.0.0.0
CLAUDE_API_PORT=8787
# CLAUDE_API_KEYS=key1,key2                    # ключи нашего API; ПУСТО = только с 127.0.0.1 (в server.env!)
# CLAUDE_API_UPSTREAM=https://api.anthropic.com

# ── пул / ротация ───────────────────────────────────────────────────────────
# SUBS_FLEET=prod                              # брать подписки только этого флота (all/пусто = любые)
# CLAUDE_API_MAX_TRIES=3                        # бюджет BACKEND-фейлов (5xx/сеть) на запрос; ошибки
#   подписки (429/401/403) бюджет НЕ тратят — крутимся по всему флоту, клиенту такая ошибка не идёт
# CLAUDE_API_MAX_INFLIGHT_PER_KEY=20           # fair-share: потолок одновременных запросов на ключ
#   (кит не набивает флот бёрстом; 0 = без лимита). Превышение → 429 «slow down».
# CLAUDE_API_UTIL_CAP=0.95                      # legacy-поле для /pool (роутинг рулит запасом ниже)
# CLAUDE_API_RESERVE_5H=0.10                    # запас 5h-окна (бережём 10% — меньше 429, не максим квоту)
# CLAUDE_API_RESERVE_7D=0.03                    # запас 7d-окна (бережём 3%)
# CLAUDE_API_RESERVE_JITTER=0.02                # ± разброс порога по подпискам (флот не режется на одном %)
# CLAUDE_API_COOL_SECS=300                      # cooling при 429 без известного reset
# CLAUDE_API_POLL=1                             # фоновый поллер лимитов (0 = выкл)

# ── автоматическая cache-affinity ──────────────────────────────────────────
# Клиенту НЕ нужен session_id: native harness headers и канонические префиксы истории определяются
# автоматически. Local L1 работает всегда; CLAUDE_API_REDIS_URL из server.env включает общий L2.
# CLAUDE_API_AFFINITY_TTL_SECS=3600             # срок общей привязки (покрывает prompt-cache)
# CLAUDE_API_AFFINITY_LOCAL_TTL_SECS=300        # быстрый per-process L1
# CLAUDE_API_AFFINITY_REDIS_TIMEOUT_MS=35       # короткий fail-open бюджет Redis
# CLAUDE_API_AFFINITY_WAIT_MS=250               # один невидимый wait тёплого занятого дома
# CLAUDE_API_AFFINITY_WAIT_MIN_BYTES=16384      # ждать только для ценного большого префикса

# ── прикладной слой Claude Code (обычно НЕ трогать вручную) ─────────────────
# Эти значения держатся АКТУАЛЬНЫМИ автоматически: tools/refresh-fingerprint.sh
# (таймер claude-api-fingerprint) снимает их с ЖИВОГО claude CLI и пишет сюда —
# чтобы не протухали при обновлениях Claude Code. Дефолты в коде — лишь fallback.
# CLAUDE_API_INJECT_IDENTITY=1                  # инжект Claude Code identity в system (нужно OAuth-токенам)
# CLAUDE_API_BETA=oauth-2025-04-20              # oauth-бета (обязательна); авто-обновляется
# CLAUDE_API_ANTHROPIC_VERSION=2023-06-01
# CLAUDE_API_UA=claude-cli/2.1.195 (external, sdk-cli)   # авто-обновляется; можно СПИСКОМ через
#   запятую (пул реальных UA) — тогда каждая персона пинит свой (антифингерпринт флота)
# CLAUDE_API_UA_SPREAD=8    # если UA один: разброс patch-версии между персонами (0/1 = выключить)
# CLAUDE_API_IDENTITY=You are a Claude agent, built on Anthropic's Claude Agent SDK.  # авто-обновляется

# ── optional Codex app-server / OpenAI-compatible text subset ────────────────
# Выключено по умолчанию. Перед включением: pinned build + ChatGPT browser/device auth; runbook:
# docs/CODEX_APP_SERVER.md. Это SDK-compatible subset, не OpenAI Platform API.
# config.env.example и tools/codex-app-server/* являются engine-scoped для watchdog: изменение
# pin/tooling или activation contract всегда проходит полный isolated gate и blue-green promotion.
# Provider-only kill switch was production-drilled through a health-gated reload on 2026-07-24.
# CLAUDE_API_CODEX_ENABLED=0
# CLAUDE_API_CODEX_BIN=/srv/claude-api/data/codex/bin/codex
# CLAUDE_API_CODEX_BIN_SHA256=<sha256 from tools/codex-app-server/build-pinned.sh>
# CLAUDE_API_CODEX_VERSION=codex-cli 0.146.0
# Пул аутентифицированных профилей: каждый home — свой supervised child, своя подписка и своё
# health-состояние. Ротация идёт по ним, как по Claude-флоту. Один home = один auth store
# (дубликаты запрещены). CLAUDE_API_CODEX_HOME остаётся односерверной формой записи.
# CLAUDE_API_CODEX_HOMES=/srv/claude-api/data/codex/home,/srv/claude-api/data/codex/home2
# Каталог, который движок СКАНИРУЕТ: каждый подкаталог с завершённым auth store — ещё один
# аккаунт в пуле. Так купленная ботом подписка входит в ротацию без рестарта, правки конфига
# и root. Незавершённая покупка (нет auth.json) в пул не попадает. Пустое значение — выключить
# скан и работать только по списку выше. Опциональный per-home прокси — файл proxy.url (0600).
# CLAUDE_API_CODEX_HOMES_DIR=/srv/claude-api/data/codex-homes
# CLAUDE_API_CODEX_HOME=/srv/claude-api/data/codex/home
# CLAUDE_API_CODEX_WORK_DIR=/srv/claude-api/data/codex/work
# CLAUDE_API_CODEX_MODELS=gpt-5.6,gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna,gpt-5.5,gpt-5.4
# Одновременных turn'ов НА КАЖДЫЙ home.
# CLAUDE_API_CODEX_MAX_CONCURRENT=4
# Запас окна: home перестаёт получать запросы на этом проценте утилизации, чтобы упереться
# в лимит честным 429 с реальным reset, а не посреди turn'а.
# CLAUDE_API_CODEX_ADMIT_BELOW_USED_PERCENT=95
# Как часто фоновый цикл перепроверяет account/read и снапшот лимитов каждого home.
# CLAUDE_API_CODEX_HEALTH_INTERVAL_SECS=300
# Прайор НЕДЕЛЬНОЙ ёмкости подписки в USD по официальным ценам API — стартовая оценка до первой
# калибровки и якорь её plausibility-гвардов (sample вне [0.25x, 4x] от этого значения
# отвергается). Измерено на ChatGPT Pro: ≈$1700-1800/неделю (2026-07, input-heavy трафик).
# Для пула Plus-аккаунтов ставьте соответственно меньшее значение. Ненедельные окна
# (например 5h) стартуют с пропорционально уменьшенного прайора.
# CLAUDE_API_CODEX_WINDOW_CAP_USD=1500
# CLAUDE_API_CODEX_STARTUP_TIMEOUT_MS=20000
# CLAUDE_API_CODEX_RPC_TIMEOUT_MS=15000
# CLAUDE_API_CODEX_TURN_TIMEOUT_MS=600000  # hard max 600000; deploy drain deadline may cancel earlier
# CLAUDE_API_CODEX_RESERVE_OVERHEAD_TOKENS=16384
# CLAUDE_API_CODEX_HISTORY_TTL_SECS=86400
# CLAUDE_API_CODEX_HISTORY_LOCAL_CAP=10000
# CLAUDE_API_CODEX_HISTORY_REDIS_TIMEOUT_MS=1000
# Если CLAUDE_API_REDIS_URL включён, общий Codex history шифруется CLAUDE_API_AFFINITY_SECRET;
# без секрета Codex provider не стартует.
# Прокси наследуются только из стандартных HTTP_PROXY/HTTPS_PROXY/ALL_PROXY/NO_PROXY.

# ── native Gemini surface / отдельный encrypted OAuth subscription pool ────
# Работает только в claude-api-gemini.service с CLAUDE_API_PROVIDER=gemini.
# CLAUDE_API_GEMINI_PROFILES_FILE=/srv/claude-api/data/gemini/profiles.json
# CLAUDE_API_GEMINI_CREDENTIAL_KEYS=current:<64-hex>[,old:<64-hex>]
# CLAUDE_API_GEMINI_MODELS=gemini-3.1-flash-lite,gemini-2.5-pro,gemini-2.5-flash,gemini-2.5-flash-lite
# CLAUDE_API_GEMINI_UPSTREAM=https://cloudcode-pa.googleapis.com
# CLAUDE_API_GEMINI_ALLOW_INSECURE_LOOPBACK_UPSTREAM=0  # только literal loopback mock
# Production unit pins these four together after shared env files; changing one requires a fresh
# official Gemini CLI wire capture and reviewed transport attestation.
# CLAUDE_API_GEMINI_CLI_VERSION=0.53.0
# CLAUDE_API_GEMINI_NODE_BINARY=/usr/bin/node
# CLAUDE_API_GEMINI_NODE_VERSION=v24.18.0
# CLAUDE_API_GEMINI_NODE_SHA256=41a74efb34cbde5c7632cdac0cf8bd1a14d0b8d73dc1e82755014d9a9ce70f5c
# CLAUDE_API_GEMINI_CONNECT_TIMEOUT_SECS=30
# CLAUDE_API_GEMINI_READ_TIMEOUT_SECS=120
# CLAUDE_API_GEMINI_MAX_TRANSPORT_RETRIES=1
# CLAUDE_API_GEMINI_AUTH_QUARANTINE_SECS=900
# CLAUDE_API_GEMINI_TRANSPORT_COOL_SECS=5
# CLAUDE_API_GEMINI_RATE_LIMIT_COOL_SECS=60
# CLAUDE_API_GEMINI_HEALTH_INTERVAL_SECS=300
# CLAUDE_API_GEMINI_RESERVE_OVERHEAD_TOKENS=8192
