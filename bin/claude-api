#!/usr/bin/env bash
# claude-api — "подписка → API": запрос к нейросети НА КВОТЕ подписки из пула, как Claude Code
# (модель на выбор, раздумья Opus, учёт токенов + USD-эквивалент по-модельно). Standalone.
#   usage: claude-api [--sub <email>] [--model <m>] [--json] [--stream] <prompt…>
#   дефолт-модель: claude-opus-4-8 (Opus 4.8, с раздумьями).
set -uo pipefail
SELF="$(cd "$(dirname "$0")/.." && pwd)"
CFG="${SUB_CFG_DIR:-$HOME/.config/claude-api}"
[ -f "$CFG/config.env" ] && . "$CFG/config.env"
DB="$CFG/subscriptions.db"
CLAUDE="${CLAUDE_BIN:-$HOME/.local/bin/claude}"
MODEL="${CLAUDE_API_MODEL:-claude-opus-4-8}"
USAGE_LOG="${CLAUDE_API_USAGE_LOG:-$CFG/usage.log}"
FMT=json; SUB=""
while [ $# -gt 0 ]; do case "$1" in
  --sub) SUB="${2:-}"; shift 2;; --model) MODEL="${2:-}"; shift 2;;
  --json) FMT=raw; shift;; --stream) FMT=stream; shift;;
  -h|--help) echo "usage: claude-api [--sub <email>] [--model <m>] [--json] [--stream] <prompt>"; exit 0;;
  --) shift; break;; *) break;;
esac; done
PROMPT="$*"
[ -n "$PROMPT" ] || { echo "usage: claude-api [--sub <email>] [--model <m>] <prompt>" >&2; exit 1; }
[ -f "$DB" ] || { echo "нет реестра $DB — добавь: scripts/subscription.sh add <email> <proxy>" >&2; exit 2; }

row=$(python3 - "$DB" "$SUB" <<'PY'
import sqlite3, sys
db=sys.argv[1]; sub=sys.argv[2] if len(sys.argv)>2 else ""
c=sqlite3.connect(db); active=""
try:
    r=c.execute("SELECT v FROM subs_meta WHERE k='active'").fetchone(); active=r[0] if r else ""
except Exception: pass
q="SELECT email,profile_dir,token_file,proxy FROM subs WHERE status='active'"; a=[]
if sub: q+=" AND email=?"; a.append(sub)
q+=" ORDER BY (email=?) DESC, added_ts ASC LIMIT 1"; a.append(active)
r=c.execute(q,a).fetchone()
if r: print("\t".join((x or "") for x in r))
PY
)
[ -n "$row" ] || { echo "нет активной подписки в пуле ($DB)" >&2; exit 2; }
IFS=$'\t' read -r email pdir tfile proxy <<<"$row"
tok=""; [ -f "$tfile" ] && tok="$(cat "$tfile")"
echo ">> подписка: $email · модель $MODEL" >&2

run() {  # claude на квоте подписки: ключ=OAuth-токен, IP=прокси
  env CLAUDE_CONFIG_DIR="$pdir" \
    ${tok:+CLAUDE_CODE_OAUTH_TOKEN="$tok"} \
    ${proxy:+HTTPS_PROXY="$proxy"} ${proxy:+HTTP_PROXY="$proxy"} \
    "$CLAUDE" -p "$PROMPT" --model "$MODEL" "$@" < /dev/null
}
if [ "$FMT" = stream ]; then run --output-format stream-json --verbose; exit $?; fi

OUT="$(run --output-format json)"; rc=$?
[ $rc -eq 0 ] || { echo "$OUT" >&2; exit $rc; }
CLAUDE_API_OUT="$OUT" CLAUDE_API_LIB="$SELF/lib" \
python3 - "$USAGE_LOG" "$email" "$MODEL" "$FMT" <<'PY'
import json, sys, os, time
log, email, model, fmt = sys.argv[1:5]
sys.path.insert(0, os.environ.get("CLAUDE_API_LIB",""))
try: import cost as C
except Exception: C=None
data=os.environ.get("CLAUDE_API_OUT","")
try: v=json.loads(data)
except Exception: print(data); sys.exit(0)
print(json.dumps(v,ensure_ascii=False,indent=2) if fmt=="raw" else v.get("result",""))
u=v.get("usage",{}) or {}
if C: usd,br=C.cost_from_usage(model,u)
else:
    br=dict(intok=u.get("input_tokens",0),out=u.get("output_tokens",0),cache_read=u.get("cache_read_input_tokens",0),cache_write=u.get("cache_creation_input_tokens",0)); usd=v.get("total_cost_usd",0)
open(log,"a").write(f"{int(time.time())}\t{email}\t{model}\tin={br['intok']}\tout={br['out']}\tcache_r={br['cache_read']}\tcache_w={br['cache_write']}\tusd={usd:.6f}\n")
print(f">> учтено на {email}: in {br['intok']} / out {br['out']} / cache {br['cache_read']}+{br['cache_write']} · USD-экв ${usd:.6f}",file=sys.stderr)
PY
