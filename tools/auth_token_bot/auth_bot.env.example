# Скопируй в безопасное место ВНЕ репозитория (например ~/.config/agents/auth_bot.env),
# заполни и chmod 600. НИКОГДА не коммить реальный токен.
AUTH_BOT_TOKEN=123456:PUT-BOT-TOKEN-FROM-BotFather-HERE
# Дев-вид: кто видит «📦 Создать оффер» и рассылает офферы всем пользователям бота.
# Через запятую — @юзернеймы и/или числовые Telegram id. Пусто = бот подскажет твой id.
# Пример: AUTH_BOT_ADMIN=YOUR_USERNAME
AUTH_BOT_ADMIN=YOUR_USERNAME
# Кому доступен setup-token-флоу (под капотом, в боте не рекламируется). Админы — всегда.
# Через запятую — @юзернеймы и/или числовые id. id надёжнее (неизменен).
AUTH_BOT_ALLOWED=
# Куда писать полученные токены (chmod 600 на каждый файл).
AUTH_BOT_TOKEN_DIR=~/.config/agents/tokens
# Реестр пользователей и офферов (users.json / offers.json).
AUTH_BOT_STATE_DIR=~/.config/agents/auth_bot_state
# Путь к claude CLI (если не дефолтный).
CLAUDE_BIN=~/.local/bin/claude

# ── Оплата USDT (BEP-20, сеть BSC) — ПОД КАПОТОМ ────────────────────────────
# Приватный ключ кошелька-ОТПРАВИТЕЛЯ. КЛАДЁТСЯ ПОЗЖЕ ВЛАДЕЛЬЦЕМ. НЕ КОММИТИТЬ!
# Без него платёж не отправится (бот покажет админу ошибку, не упадёт).
AUTH_BOT_BSC_PKEY=
# RPC BSC (можно свой/приватный для надёжности).
AUTH_BOT_BSC_RPC=https://bsc-dataseed.binance.org/
# Gas price в gwei (как просили — 0.2).
AUTH_BOT_BSC_GWEI=0.2
# Порог выплаты: до этой суммы — обычное подтверждение, свыше — ВТОРОЕ подтверждение.
AUTH_BOT_MAX_USDT=300
# chainId: 56 = BSC mainnet.
AUTH_BOT_BSC_CHAIN_ID=56
# Контракт USDT на BSC (Binance-Peg BSC-USD, 18 знаков). Меняй, только если знаешь зачем.
AUTH_BOT_USDT_CONTRACT=0x55d398326f99059fF775485246999027B3197955
AUTH_BOT_USDT_DECIMALS=18
# Для реального перевода на хосте: pip install "web3>=6"
