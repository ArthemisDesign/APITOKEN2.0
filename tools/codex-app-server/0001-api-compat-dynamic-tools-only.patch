+    assert_eq!(plan.registered_names, vec!["customer_function", "exec"]);
+    let ToolSpec::Freeform(exec) = &plan.visible_specs[1] else {
+        panic!("exec must remain a freeform Responses tool");
+    };
+    assert_eq!(exec.format.r#type, "grammar");
+    assert_eq!(exec.format.syntax, "lark");
+    assert_eq!(exec.format.definition, "start: /[\\s\\S]+/");
+}
