{
  "name": "claude-api-platform",
  "private": true,
  "packageManager": "pnpm@9.7.0",
  "engines": {
    "node": ">=24 <25"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.18",
      "sharp": ">=0.35.0"
    }
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev:api": "pnpm --filter @claude-api/commercial-api dev",
    "dev:worker": "pnpm --filter @claude-api/payment-worker dev",
    "dev:web": "pnpm --filter @claude-api/web dev",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:integration": "bash deploy/local-test-databases.sh integration-test",
    "db:generate": "pnpm --filter @claude-api/db db:generate",
    "db:migrate": "pnpm --filter @claude-api/db db:migrate"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  }
}
