[Unit]
Description=Staging unified router slot on port %i
Requires=apitoken-staging-foundation-install.service
After=apitoken-staging-foundation-install.service
ConditionPathIsMountPoint=/var/lib/apitoken-staging
ConditionPathExists=/srv/claude-api-staging/releases/current/claude-router

[Service]
Type=simple
User=deploy-stage
Group=deploy-stage
Slice=staging.slice
NetworkNamespacePath=/run/netns/apitoken-stage
EnvironmentFile=/etc/apitoken-staging/router.env
ExecStart=/usr/bin/env CLAUDE_ROUTER_BODY_SPOOL_ROOT=/var/lib/apitoken-staging/spool/router-%i CLAUDE_ROUTER_MAX_BODY_MIB=256 CLAUDE_ROUTER_HOST=127.0.0.1 CLAUDE_ROUTER_PORT=%i CLAUDE_ROUTER_KIMI_ORIGIN=http://127.0.0.1:8804 /srv/claude-api-staging/releases/current/claude-router
Restart=on-failure
RestartSec=1
KillSignal=SIGTERM
TimeoutStopSec=660
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
StateDirectory=apitoken-staging/spool/router-%i
StateDirectoryMode=0700
ReadWritePaths=/var/lib/apitoken-staging/spool
MemoryMax=8G

[Install]
WantedBy=staging.slice
