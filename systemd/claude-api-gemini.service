# PostgreSQL-fenced native Gemini surface backed by encrypted paid Antigravity OAuth profiles. The
# runtime rotates subscriptions independently from the Claude and OpenAI provider services.
[Unit]
Description=claude-api isolated Gemini OAuth subscription-pool provider
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
Environment=SUB_CFG_DIR=/srv/claude-api/data
EnvironmentFile=-/srv/claude-api/data/config.env
EnvironmentFile=-/srv/claude-api/data/server.env
EnvironmentFile=/srv/claude-api/data/engine-postgres.env
# Argv-level assignments cannot be overridden by a shared EnvironmentFile. Keep the production
# credential layout sealed; both ClaudeStore switches belong to other provider planes.
ExecStart=/usr/bin/env CLAUDE_API_PRICING_BRIDGE_ENABLED=1 CLAUDE_API_PRICING_BRIDGE_SAMPLE_BP=10000 CLAUDE_API_PROVIDER=gemini CLAUDE_API_CLAUDESTORE_FALLBACK_ENABLED=0 CLAUDE_API_CLAUDESTORE_CODEX_FALLBACK_ENABLED=0 CLAUDE_API_TRUST_LOOPBACK=0 CLAUDE_API_HOST=127.0.0.1 CLAUDE_API_PORT=8795 CLAUDE_API_INSTANCE_ID=%H:engine:gemini CLAUDE_API_GEMINI_PROFILES_FILE=/srv/claude-api/data/gemini/profiles.json CLAUDE_API_GEMINI_CREDENTIAL_LAYOUT=sealed-roster CLAUDE_API_GEMINI_MODELS=gemini-3.1-flash-image,gemini-3.7-flash,gemini-3.6-flash,gemini-3.5-flash,gemini-3-flash-preview,gemini-3.1-pro-preview,gemini-3.1-flash-lite,gemini-2.5-flash,gemini-2.5-flash-lite CLAUDE_API_GEMINI_UPSTREAM=https://daily-cloudcode-pa.sandbox.googleapis.com CLAUDE_API_GEMINI_ALLOW_INSECURE_LOOPBACK_UPSTREAM=0 CLAUDE_API_GEMINI_ANTIGRAVITY_VERSION=2.2.1 CLAUDE_API_GEMINI_NODE_BINARY=/usr/bin/node CLAUDE_API_GEMINI_NODE_VERSION=v24.18.0 CLAUDE_API_GEMINI_NODE_SHA256=41a74efb34cbde5c7632cdac0cf8bd1a14d0b8d73dc1e82755014d9a9ce70f5c CLAUDE_API_TEXT_BODY_MAX_MIB=32 CLAUDE_API_BODY_MEMORY_BUDGET_MIB=2048 CLAUDE_API_BODY_SPOOL_BUDGET_MIB=2048 CLAUDE_API_BODY_MEMORY_THRESHOLD_MIB=32 CLAUDE_API_NONSTREAM_RESPONSE_MAX_MIB=64 /srv/claude-api/releases/current/claude-api serve
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=720
UMask=0077
LimitCORE=0
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadWritePaths=/srv/claude-api/data
# Profiles and encrypted OAuth envelopes are atomically provisioned by authbot; the gateway only
# decrypts them in memory, refreshes access tokens single-flight and never exposes account identity.
# Auth Bot or provisioning creates this layout before runtime start. Absence fails the unit closed;
# otherwise an optional bind skipped at startup could become writable when the directory appears.
ReadOnlyPaths=/srv/claude-api/data/gemini
MemoryMax=2G

[Install]
WantedBy=multi-user.target
