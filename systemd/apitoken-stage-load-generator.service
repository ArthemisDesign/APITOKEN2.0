[Unit]
Description=Bounded staging degradation load generator
Requires=apitoken-stage-caddy.service
After=apitoken-stage-caddy.service

[Service]
Type=oneshot
User=deploy-stage
Group=deploy-stage
Slice=staging.slice
NetworkNamespacePath=/run/netns/apitoken-stage
ExecStart=/usr/local/lib/apitoken-watchdog/stage-load-generator.py
RuntimeMaxSec=120
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
MemoryMax=256M
CPUQuota=50%
TasksMax=64
