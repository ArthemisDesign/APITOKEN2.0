[Unit]
Description=Staging OpenAI provider slot on port %i
Requires=apitoken-staging-foundation-install.service
After=apitoken-staging-foundation-install.service
ConditionPathIsMountPoint=/var/lib/apitoken-staging
ConditionPathExists=/srv/claude-api-staging/releases/current/claude-api
ConditionPathExists=/etc/apitoken-staging/openai.live

[Service]
Type=simple
User=deploy-stage
Group=deploy-stage
Slice=staging.slice
NetworkNamespacePath=/run/netns/apitoken-stage
EnvironmentFile=/srv/claude-api-staging/data/server.env
EnvironmentFile=/srv/claude-api-staging/data/engine-postgres.env
EnvironmentFile=/etc/apitoken-staging/openai.env
ExecStart=/usr/bin/env CLAUDE_API_BODY_SPOOL_ROOT=/run/claude-api-stage-openai-%i CLAUDE_API_PROVIDER=openai CLAUDE_API_HOST=127.0.0.1 CLAUDE_API_PORT=%i CLAUDE_API_INSTANCE_ID=stage:engine:openai:%i CLAUDE_API_TRUST_LOOPBACK=0 /srv/claude-api-staging/releases/current/claude-api serve
Restart=on-failure
RestartSec=3
RuntimeDirectory=claude-api-stage-openai-%i
RuntimeDirectoryMode=0700
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/run/claude-api-stage-openai-%i /srv/claude-api-staging/data
MemoryMax=8G

[Install]
WantedBy=staging.slice
