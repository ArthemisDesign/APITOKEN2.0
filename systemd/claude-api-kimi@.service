# Health-gated KIMI slot. Only one slot accepts new traffic in steady state; during cutover the
# old process drains established streams while the candidate serves new requests. The plane is
# backend-only by design: no public hostname. Customer `kimi/*` is the unified-router
# namespace and reaches this plane via origin 8803.
[Unit]
Description=claude-api KIMI subscription-pool slot on port %i
After=network-online.target apitoken-affinity-redis.service
Wants=network-online.target apitoken-affinity-redis.service

[Service]
Type=simple
User=deploy
Group=deploy
Environment=SUB_CFG_DIR=/srv/claude-api/data
EnvironmentFile=-/srv/claude-api/data/config.env
EnvironmentFile=-/srv/claude-api/data/server.env
EnvironmentFile=/srv/claude-api/data/engine-postgres.env
# A release predating the slot-safe handoff must never be started through this template. The
# legacy singleton remains installed solely so rollback can run such a release on 8804.
ExecCondition=/usr/bin/test -f /srv/claude-api/releases/current/.kimi-bluegreen-v1
ExecCondition=/usr/bin/test ! -L /srv/claude-api/releases/current/.kimi-bluegreen-v1
ExecCondition=/usr/bin/grep -Fxq kimi-bluegreen-v1 /srv/claude-api/releases/current/.kimi-bluegreen-v1
# Argv-level assignments cannot be overridden by a shared EnvironmentFile. CLAUDE_API_KIMI_ENABLED=1
# is pinned here on purpose: the plane's on/off state lives only in this reviewed unit, never in a
# shared config.env value. This enablement followed the live evidence of 2026-08-04 (owned Vivace
# subscription connected through Auth Bot; /me, /usages and an exactly metered generation proven —
# docs/engine/KIMI_PROVIDER.md). Disablement is the reverse reviewed unit change. The Anthropic
# plane keeps KIMI off so exactly one process ever runs the maintenance writer. Both ClaudeStore
# switches belong to other provider planes and must remain disabled here.
ExecStart=/usr/bin/env CLAUDE_API_BODY_SPOOL_ROOT=/run/claude-api-kimi-%i CLAUDE_API_PROVIDER=kimi CLAUDE_API_CLAUDESTORE_FALLBACK_ENABLED=0 CLAUDE_API_CLAUDESTORE_CODEX_FALLBACK_ENABLED=0 CLAUDE_API_TRUST_LOOPBACK=0 CLAUDE_API_HOST=127.0.0.1 CLAUDE_API_PORT=%i CLAUDE_API_INSTANCE_ID=%H:engine:kimi:%i CLAUDE_API_KIMI_ENABLED=1 CLAUDE_API_TEXT_BODY_MAX_MIB=32 CLAUDE_API_BODY_MEMORY_BUDGET_MIB=2048 CLAUDE_API_BODY_SPOOL_BUDGET_MIB=2048 CLAUDE_API_BODY_MEMORY_THRESHOLD_MIB=32 CLAUDE_API_NONSTREAM_RESPONSE_MAX_MIB=64 /srv/claude-api/releases/current/claude-api serve
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=720
UMask=0077
LimitCORE=0
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RuntimeDirectory=claude-api-kimi-%i
RuntimeDirectoryMode=0700
ReadWritePaths=/run/claude-api-kimi-%i
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadWritePaths=/srv/claude-api/data
# The roster directory is read-only except credentials/: KIMI's rotating refresh family legally
# requires the runtime to atomically reseal the credential envelope after a won refresh, so the
# envelope directory must stay writable or every token expiry reads as an auth death. The roster
# file itself (profiles.json) remains Auth Bot's alone — the runtime never writes it.
ReadOnlyPaths=/srv/claude-api/data/kimi
ReadWritePaths=/srv/claude-api/data/kimi/credentials
MemoryMax=2G

[Install]
WantedBy=multi-user.target
