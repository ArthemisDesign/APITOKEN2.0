[Unit]
Description=API Token Sale tested automatic production deploy watchdog
After=network-online.target docker.service apitoken-postgres.service
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
Environment=HOME=/home/deploy
Environment=CARGO_HOME=/var/lib/apitoken/watchdog/deploy-build-cache/cargo
Environment=XDG_CACHE_HOME=/var/lib/apitoken/watchdog/deploy-build-cache/xdg-cache
Environment=XDG_CONFIG_HOME=/var/lib/apitoken/watchdog/deploy-build-cache/xdg-config
Environment=XDG_DATA_HOME=/var/lib/apitoken/watchdog/deploy-build-cache/xdg-data
Environment=PATH=/home/deploy/.cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/lib/apitoken-watchdog/watchdog.sh
TimeoutStartSec=45min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

# The controller needs network access for GitHub and fixed sudo operations for service cutovers.
# Candidate builds/tests run separately as the unprivileged apitoken-ci account.
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
# Exact tested infrastructure updates may replace only the controller-owned operational files.
# /etc/systemd rather than only /etc/systemd/system: journald's drop-in directory lives beside the
# unit directory, and ProtectSystem=full makes the rest of /etc read-only, so the controller cannot
# create /etc/systemd/journald.conf.d without this. The unit directory already listed here is the
# far more powerful grant, so widening to the parent adds little. A path must exist to be bind
# mounted read-write, which is why this names /etc/systemd and not the drop-in directory itself.
ReadWritePaths=/var/lib/apitoken/watchdog /var/lib/apitoken/monitoring /var/lib/apitoken/gemini-3-7-admission /opt/apitoken /srv/claude-api/releases /srv/claude-api/data /run/lock /usr/local/lib/apitoken-watchdog /usr/local/bin /etc/systemd /etc/systemd/system /etc/caddy /etc/apitoken
