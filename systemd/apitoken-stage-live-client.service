[Unit]
Description=Capped staging client for production fleet
Requires=apitoken-staging-foundation-install.service
After=apitoken-staging-foundation-install.service
ConditionPathExists=/etc/apitoken-staging/stage-live.enabled
ConditionFileNotEmpty=/etc/apitoken-staging/stage-live.key

[Service]
Type=simple
User=deploy-stage
Group=deploy-stage
Slice=staging.slice
NetworkNamespacePath=/run/netns/apitoken-stage
ExecStart=/usr/local/lib/apitoken-watchdog/stage-live-proxy.py
Restart=on-failure
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadOnlyPaths=/etc/apitoken-staging/stage-live.key
RestrictAddressFamilies=AF_INET AF_UNIX
MemoryMax=256M
CPUQuota=50%
TasksMax=64

[Install]
WantedBy=staging.slice
