[Unit]
Description=API Token Sale admin panel (admin.apitoken.sale, port 3700)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/opt/apitoken/admin-releases/current/apps/admin
ExecStart=/opt/apitoken/admin-releases/current/apps/admin/node_modules/.bin/next start -H 127.0.0.1 -p 3700
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
CapabilityBoundingSet=
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
UMask=0077

[Install]
WantedBy=multi-user.target
