# Прогрев общего OAuth-профиля + раздача токена во все коробки. ЕДИНСТВЕННЫЙ
# ротатор (параллельная ротация = каскадный логаут). Замена launchd
# com.youruser.token-refresh (StartInterval 1200). Дёргается token-refresh.timer.
[Unit]
Description=Refresh shared Claude OAuth token and distribute to all boxes
After=docker.service
Wants=docker.service

[Service]
Type=oneshot
User=agents
Group=agents
EnvironmentFile=-/etc/agents/box.env
ExecStart=/srv/agents/AgentsCloningFork/scripts/box_docker.sh token-refresh
