# PostgreSQL-fenced Anthropic slot. Instance name is the loopback port (8787 or 8788).
[Unit]
Description=claude-api Anthropic provider slot on port %i
After=network-online.target apitoken-affinity-redis.service
Wants=network-online.target apitoken-affinity-redis.service

[Service]
Slice=claude-api-anthropic.slice
Type=simple
User=deploy
Group=deploy
Environment=SUB_CFG_DIR=/srv/claude-api/data
EnvironmentFile=-/srv/claude-api/data/config.env
EnvironmentFile=-/srv/claude-api/data/server.env
EnvironmentFile=/srv/claude-api/data/engine-postgres.env
# `/usr/bin/env` is deliberately at ExecStart: EnvironmentFile values override `Environment=`
# regardless of their textual order, while argv-level assignments always win for the slot. The
# shared secret env may later enable provider previews or the OpenAI-only GPT fallback; neither
# may leak into this public plane. GLM remains a backend-only preview without a live subscription
# or a compliant private serving boundary, so the public Anthropic unit pins it off even when a
# staged keyring remains in the shared env.
#
# KIMI aliases stay composed here as a safety net for this SHA: `api.apitoken.sale` still
# reaches these slots, and a cold dedicated plane must not drop a direct KIMI alias into the
# Claude pool (that fall-through became a 529 on 2026-08-07). Customer `kimi/*` through
# `router.apitoken.sale` goes to the dedicated origin 8803. A follow-up pin
# `CLAUDE_API_KIMI_ENABLED=0` removes this embed after that router dataplane is GREEN.
#
# The 180-second drain pin is argv-level for the same reason as the GLM pin: a stale long value in
# the shared env must not silently re-widen the deploy window. The engine already defaults to 180;
# this slot held the 540s default that made every blue-green cutover sit through the full deadline.
ExecStart=/usr/bin/env CLAUDE_API_BODY_SPOOL_ROOT=/run/claude-api-anthropic-%i CLAUDE_API_PRICING_BRIDGE_ENABLED=1 CLAUDE_API_PRICING_BRIDGE_SAMPLE_BP=10000 CLAUDE_API_PROVIDER=anthropic CLAUDE_API_CLAUDESTORE_CODEX_FALLBACK_ENABLED=0 CLAUDE_API_GLM_ENABLED=0 CLAUDE_API_TRUST_LOOPBACK=0 CLAUDE_API_HOST=127.0.0.1 CLAUDE_API_PORT=%i CLAUDE_API_INSTANCE_ID=%H:engine:anthropic:%i CLAUDE_API_KIMI_ENABLED=1 CLAUDE_API_DRAIN_DEADLINE_SECS=180 CLAUDE_API_TEXT_BODY_MAX_MIB=32 CLAUDE_API_BODY_MEMORY_BUDGET_MIB=2048 CLAUDE_API_BODY_SPOOL_BUDGET_MIB=2048 CLAUDE_API_BODY_MEMORY_THRESHOLD_MIB=32 CLAUDE_API_NONSTREAM_RESPONSE_MAX_MIB=256 /srv/claude-api/releases/current/claude-api serve
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=720
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RuntimeDirectory=claude-api-anthropic-%i
RuntimeDirectoryMode=0700
LimitNOFILE=262144
TasksMax=8192
OOMPolicy=stop
ReadWritePaths=/run/claude-api-anthropic-%i
ReadWritePaths=/srv/claude-api/data
MemoryHigh=6G
MemoryMax=8G

[Install]
WantedBy=multi-user.target
