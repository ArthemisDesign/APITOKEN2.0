# Бот пополнения пула: покупает подписки у продавцов и передаёт их движку.
#
# Claude-подписка становится строкой-токеном в реестре, ChatGPT-подписка — каталогом CODEX_HOME,
# который движок сканирует. Поэтому боту нужен доступ на запись в каталог покупок и к пиннованному
# codex CLI, но НЕ нужен root и не нужны права на конфиг движка.
#
# Бинарь берётся из той же неизменяемой релизной директории, что и движок. Изменённый authbot
# перезапускается после promotion; persisted handoff state восстанавливает прерванный OAuth на email.
[Unit]
Description=claude-api authbot (subscription purchasing → this project's pool)
After=network-online.target apitoken-postgres.service
Wants=network-online.target apitoken-postgres.service

[Service]
Type=simple
User=deploy
Group=deploy
Environment=HOME=/srv/claude-api/data/authbot
Environment=AUTH_BOT_CLAUDE_BIN=/run/claude-authbot/claude
EnvironmentFile=/srv/claude-api/data/authbot.env
EnvironmentFile=/srv/claude-api/data/engine-postgres.env
# Command assignments override legacy CLAUDE_BIN from EnvironmentFile even for the old binary that
# may still be current when an infrastructure transaction restarts this unit before promotion.
ExecStart=/usr/bin/env CLAUDE_BIN=/run/claude-authbot/claude AUTH_BOT_CLAUDE_BIN=/run/claude-authbot/claude /srv/claude-api/releases/current/authbot
WorkingDirectory=/srv/claude-api/data
Restart=always
RestartSec=5
RuntimeDirectory=claude-authbot
RuntimeDirectoryMode=0700

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
# Resolve the official install before hiding /home, then expose only its executable at runtime.
# A bind mounted below hidden /home remains unreachable even when the leaf itself is mounted.
BindReadOnlyPaths=/home/deploy/.local/bin/claude:/run/claude-authbot/claude
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
# Пишет состояние бота, каталоги купленных аккаунтов и токены подписок.
ReadWritePaths=/srv/claude-api/data

[Install]
WantedBy=multi-user.target
