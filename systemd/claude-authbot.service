# Бот пополнения пула: покупает подписки у продавцов и передаёт их движку.
#
# Claude-подписка становится строкой-токеном в реестре, ChatGPT-подписка — sealed-профилем в roster,
# а Antigravity OAuth — AEAD-конвертом и атомарной записью в отдельный Gemini roster.
# Поэтому боту нужен доступ на запись в каталоги покупок и к пиннованному codex CLI, но НЕ нужен
# root и не нужны права на config.env или управление сервисами.
#
# Бинарь берётся из той же неизменяемой релизной директории, что и движок. Изменённый authbot
# перезапускается после promotion; persisted handoff state восстанавливает прерванный OAuth на email.
[Unit]
Description=claude-api authbot (subscription purchasing → this project's pool)
After=network-online.target apitoken-postgres.service
Wants=network-online.target apitoken-postgres.service

[Service]
Type=simple
User=deploy
Group=deploy
Environment=HOME=/srv/claude-api/data/authbot
Environment=AUTH_BOT_CLAUDE_BIN=/run/claude-authbot/claude
EnvironmentFile=/srv/claude-api/data/authbot.env
EnvironmentFile=/srv/claude-api/data/engine-postgres.env
# Reuse the engine control key for the loopback-only proxy-admin listener. The leading dash keeps
# rollback to an older release possible while the shared environment is first being provisioned.
EnvironmentFile=-/srv/claude-api/data/server.env
# Command assignments override legacy values from EnvironmentFile even for the old binary that may
# still be current when an infrastructure transaction restarts this unit before promotion.
ExecStart=/usr/bin/env CLAUDE_BIN=/run/claude-authbot/claude AUTH_BOT_CLAUDE_BIN=/run/claude-authbot/claude AUTH_BOT_CODEX_HOMES_DIR=/srv/claude-api/data/codex-staging AUTH_BOT_CODEX_ROSTER_DIR=/srv/claude-api/data/codex /srv/claude-api/releases/current/authbot
WorkingDirectory=/srv/claude-api/data
Restart=always
RestartSec=5
RuntimeDirectory=claude-authbot
RuntimeDirectoryMode=0700
UMask=0077
LimitCORE=0

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
# Resolve the official install before hiding /home, then expose only its executable at runtime.
# A bind mounted below hidden /home remains unreachable even when the leaf itself is mounted.
BindReadOnlyPaths=/home/deploy/.local/bin/claude:/run/claude-authbot/claude
PrivateDevices=true
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelLogs=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
RestrictSUIDSGID=true
# Пишет состояние бота, Codex homes, Claude tokens и закрытый Gemini OAuth credential roster.
ReadWritePaths=/srv/claude-api/data

[Install]
WantedBy=multi-user.target
