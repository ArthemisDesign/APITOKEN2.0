# subs-reorder-alert — оповещение о ДОЗАКАЗЕ клиентской подписки.
# Считает ёмкость продаж prod-флота (subs_capacity_calc) и при 🟡/🔴 шлёт алерт
# админам ЧЕРЕЗ ТОКЕН бота покупки токенов (auth_token_bot) — код бота не трогаем.
# Дедуп в reorder_alert.json (смена сигнала / кулдаун). Дёргается таймером.
[Unit]
Description=Alert operators (via token-bot) when subscription sales capacity runs low
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=agents
Group=agents
Environment=HOME=/srv/agents
Environment=SUBS_DB=/srv/agents/.config/personal-agents/subscriptions.db
EnvironmentFile=-/etc/agents/auth_bot.env
ExecStart=/usr/bin/python3 /srv/agents/AgentsCloningFork/scripts/subs_reorder_alert.py
