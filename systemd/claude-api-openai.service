# PostgreSQL-fenced OpenAI-compatible provider. The native transport owns no child processes;
# the unit stays a singleton only by deployment habit, not by an ownership requirement.
[Unit]
Description=claude-api OpenAI-compatible Codex provider
After=network-online.target apitoken-affinity-redis.service
Wants=network-online.target apitoken-affinity-redis.service

[Service]
Type=simple
User=deploy
Group=deploy
Environment=SUB_CFG_DIR=/srv/claude-api/data
EnvironmentFile=-/srv/claude-api/data/config.env
EnvironmentFile=-/srv/claude-api/data/server.env
EnvironmentFile=/srv/claude-api/data/engine-postgres.env
# Argv-level assignments cannot be overridden by a shared EnvironmentFile. In particular, the
# Anthropic-only ClaudeStore switch must stay disabled even when the shared secret env enables it.
ExecStart=/usr/bin/env CLAUDE_API_PROVIDER=openai CLAUDE_API_CLAUDESTORE_FALLBACK_ENABLED=0 CLAUDE_API_TRUST_LOOPBACK=0 CLAUDE_API_HOST=127.0.0.1 CLAUDE_API_PORT=8793 CLAUDE_API_INSTANCE_ID=%H:engine:openai CLAUDE_API_CODEX_PROFILES_FILE=/srv/claude-api/data/codex/profiles.json /srv/claude-api/releases/current/claude-api serve
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=660
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/claude-api/data
MemoryMax=2G

[Install]
WantedBy=multi-user.target
