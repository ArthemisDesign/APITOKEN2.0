# PostgreSQL-fenced OpenAI-compatible provider. The native transport owns no child processes;
# the unit stays a singleton only by deployment habit, not by an ownership requirement.
[Unit]
Description=claude-api OpenAI-compatible Codex provider
After=network-online.target apitoken-affinity-redis.service
Wants=network-online.target apitoken-affinity-redis.service

[Service]
Type=simple
User=deploy
Group=deploy
Environment=SUB_CFG_DIR=/srv/claude-api/data
EnvironmentFile=-/srv/claude-api/data/config.env
EnvironmentFile=-/srv/claude-api/data/server.env
EnvironmentFile=/srv/claude-api/data/engine-postgres.env
# Argv-level assignments cannot be overridden by a shared EnvironmentFile. The Anthropic-only
# ClaudeStore switch stays disabled; the separate Codex-tier switch intentionally remains inherited.
ExecStart=/usr/bin/env CLAUDE_API_PROVIDER=openai CLAUDE_API_CLAUDESTORE_FALLBACK_ENABLED=0 CLAUDE_API_TRUST_LOOPBACK=0 CLAUDE_API_HOST=127.0.0.1 CLAUDE_API_PORT=8793 CLAUDE_API_INSTANCE_ID=%H:engine:openai CLAUDE_API_CODEX_PROFILES_FILE=/srv/claude-api/data/codex/profiles.json CLAUDE_API_TEXT_BODY_MAX_MIB=32 CLAUDE_API_BODY_MEMORY_BUDGET_MIB=2048 CLAUDE_API_BODY_SPOOL_BUDGET_MIB=2048 CLAUDE_API_BODY_MEMORY_THRESHOLD_MIB=32 CLAUDE_API_NONSTREAM_RESPONSE_MAX_MIB=64 /srv/claude-api/releases/current/claude-api serve
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=720
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/claude-api/data
MemoryMax=2G

[Install]
WantedBy=multi-user.target
