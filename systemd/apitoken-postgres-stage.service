[Unit]
Description=Empty PostgreSQL placeholder in staging contour
Requires=apitoken-rootless-docker-stage.service
After=apitoken-rootless-docker-stage.service
ConditionPathIsMountPoint=/var/lib/apitoken-staging

[Service]
Type=oneshot
RemainAfterExit=yes
User=deploy-stage
Group=deploy-stage
Slice=staging.slice
Environment=DOCKER_HOST=unix:///run/apitoken-staging/docker.sock
ExecStart=/usr/bin/docker compose --project-name apitoken-stage-postgres -f /usr/local/lib/apitoken-watchdog/staging-postgres.compose.yaml up -d --wait
ExecStop=/usr/bin/docker compose --project-name apitoken-stage-postgres -f /usr/local/lib/apitoken-watchdog/staging-postgres.compose.yaml down
TimeoutStartSec=180
