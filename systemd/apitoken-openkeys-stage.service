[Unit]
Description=Staging OpenKeys
Requires=apitoken-postgres-stage.service
After=apitoken-postgres-stage.service
ConditionPathIsMountPoint=/var/lib/apitoken-staging
ConditionPathExists=/opt/apitoken-staging/openkeys-releases/current/apps/openkeys/node_modules/.bin/next
ConditionFileNotEmpty=/etc/apitoken-staging/openkeys.env

[Service]
Type=simple
User=deploy-stage
Group=deploy-stage
Slice=staging.slice
NetworkNamespacePath=/run/netns/apitoken-stage
WorkingDirectory=/opt/apitoken-staging/openkeys-releases/current/apps/openkeys
EnvironmentFile=/etc/apitoken-staging/openkeys.env
ExecStart=/opt/apitoken-staging/openkeys-releases/current/apps/openkeys/node_modules/.bin/next start -H 127.0.0.1 -p 3410
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
MemoryMax=1G

[Install]
WantedBy=staging.slice
