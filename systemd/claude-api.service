# Прозрачный /v1 API поверх пула Claude-подписок (Rust). Слушает порт (деф. 8787),
# форвардит на api.anthropic.com на квоте подписок с ротацией по лимитам.
# Логи: journalctl -u claude-api -f
[Unit]
Description=claude-api — subscription pool as transparent Anthropic /v1 API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
Environment=SUB_CFG_DIR=/srv/claude-api/data
# Общий конфиг (модель/порт/пул) и ОТДЕЛЬНО секреты (ключи API):
EnvironmentFile=-/srv/claude-api/data/config.env
EnvironmentFile=-/srv/claude-api/data/server.env
# Activated only by the guarded Stage-2 cutover. Root-owned 0600 because it contains the DB role secret.
EnvironmentFile=-/srv/claude-api/data/engine-postgres.env
# The legacy combined rollback anchor reads the shared engine env. Keep the GLM backend preview
# fail-closed here: it has no live subscription or compliant private serving boundary. The 180s
# drain pin keeps the old 540s shared-env default from re-widening the blue-green deploy window.
ExecStart=/usr/bin/env CLAUDE_API_GLM_ENABLED=0 CLAUDE_API_DRAIN_DEADLINE_SECS=180 /srv/claude-api/releases/current/claude-api serve
Restart=on-failure
RestartSec=3
# Graceful shutdown: сервер по SIGTERM дренирует in-flight стримы (см. serve()). Даём время дотечь
# длинным генерациям и сделать финальный флаш состояния, иначе systemd убьёт SIGKILL.
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=720
# Базовый hardening (сервис не пишет никуда, кроме своей data-папки):
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/claude-api/data
# Крыша по памяти (bindings/live ограничены, но страхуемся от рантайм-аномалий):
MemoryMax=2G

[Install]
WantedBy=multi-user.target
