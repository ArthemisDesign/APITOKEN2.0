# Health-gated OpenAI HTTP slot. Both generations may overlap freely: the native Codex provider
# reads the same sealed credential roster and owns no per-generation child processes.
[Unit]
Description=claude-api OpenAI-compatible gateway slot on port %i
After=network-online.target apitoken-affinity-redis.service
Wants=network-online.target apitoken-affinity-redis.service

[Service]
Slice=claude-api-openai.slice
Type=simple
User=deploy
Group=deploy
Environment=SUB_CFG_DIR=/srv/claude-api/data
EnvironmentFile=-/srv/claude-api/data/config.env
EnvironmentFile=-/srv/claude-api/data/server.env
EnvironmentFile=/srv/claude-api/data/engine-postgres.env
# A pre-migration binary expects the app-server machinery and would misread the sealed roster.
# Refuse the process even if an operator accidentally starts/enables this template during rollback.
ExecCondition=/usr/bin/test -f /srv/claude-api/releases/current/.openai-bluegreen-v1
ExecCondition=/usr/bin/test ! -L /srv/claude-api/releases/current/.openai-bluegreen-v1
ExecCondition=/usr/bin/grep -Fxq openai-bluegreen-v1 /srv/claude-api/releases/current/.openai-bluegreen-v1
# Keep only the Anthropic emergency fallback invalid here. The separate Codex-tier switch is
# intentionally inherited so the inactive OpenAI slot can receive a controlled dormant rollout.
ExecStart=/usr/bin/env CLAUDE_API_BODY_SPOOL_ROOT=/run/claude-api-openai-%i CLAUDE_API_PRICING_BRIDGE_ENABLED=1 CLAUDE_API_PRICING_BRIDGE_SAMPLE_BP=10000 CLAUDE_API_PROVIDER=openai CLAUDE_API_CLAUDESTORE_FALLBACK_ENABLED=0 CLAUDE_API_TRUST_LOOPBACK=0 CLAUDE_API_HOST=127.0.0.1 CLAUDE_API_PORT=%i CLAUDE_API_INSTANCE_ID=%H:engine:openai:%i CLAUDE_API_TEXT_BODY_MAX_MIB=32 CLAUDE_API_BODY_MEMORY_BUDGET_MIB=2048 CLAUDE_API_BODY_SPOOL_BUDGET_MIB=2048 CLAUDE_API_BODY_MEMORY_THRESHOLD_MIB=32 CLAUDE_API_NONSTREAM_RESPONSE_MAX_MIB=64 /srv/claude-api/releases/current/claude-api serve
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=720
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RuntimeDirectory=claude-api-openai-%i
RuntimeDirectoryMode=0700
LimitNOFILE=262144
TasksMax=8192
OOMPolicy=stop
ReadWritePaths=/run/claude-api-openai-%i
ReadWritePaths=/srv/claude-api/data
MemoryHigh=6G
MemoryMax=8G

[Install]
WantedBy=multi-user.target
