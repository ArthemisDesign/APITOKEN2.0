# Unified stateless router (docs/engine/UNIFIED_ROUTER.md, stage 1b). Singleton:
# the router is stateless and fronts the health-gated plane origins, so a brief
# restart window is covered by clients reconnecting; blue-green replicas are a
# later stage. The unit owns no child processes and no data directory.
[Unit]
Description=claude-api unified stateless router
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
# Argv-level assignments cannot be overridden by a shared EnvironmentFile.
ExecStart=/usr/bin/env CLAUDE_ROUTER_HOST=127.0.0.1 CLAUDE_ROUTER_PORT=8798 /srv/claude-api/releases/current/claude-router
Restart=on-failure
RestartSec=1
KillSignal=SIGTERM
KillMode=mixed
# In-flight SSE streams finish inside this window after SIGTERM; the planes
# settle them correctly through the TeeMeter drain even if the window closes.
TimeoutStopSec=30
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
MemoryMax=512M

[Install]
WantedBy=multi-user.target
