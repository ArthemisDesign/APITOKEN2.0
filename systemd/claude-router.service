# Legacy unified-router singleton retained only as the availability anchor for the one-time
# migration to claude-router@8800/8801. New deployments are owned by router-bluegreen.sh and never
# restart this unit. Remove it only after the documented rollback horizon no longer includes a
# pre-blue-green release.
[Unit]
Description=claude-api unified stateless router
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
# Argv-level assignments cannot be overridden by a shared EnvironmentFile.
ExecStart=/usr/bin/env CLAUDE_ROUTER_MAX_BODY_MIB=32 CLAUDE_ROUTER_BODY_MEMORY_BUDGET_MIB=128 CLAUDE_ROUTER_BODY_SPOOL_BUDGET_MIB=128 CLAUDE_ROUTER_BODY_MEMORY_THRESHOLD_MIB=32 CLAUDE_ROUTER_BODY_IDLE_SECS=60 CLAUDE_ROUTER_BODY_MAX_SECS=300 CLAUDE_ROUTER_HOST=127.0.0.1 CLAUDE_ROUTER_PORT=8798 /srv/claude-api/releases/current/claude-router
Restart=on-failure
RestartSec=1
KillSignal=SIGTERM
KillMode=mixed
# The migration controller first removes this backend from Caddy, then lets in-flight SSE finish.
# Match the slot drain so the one-time 8798 -> 8800 handoff does not retain the old 30-second cut.
TimeoutStopSec=660
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
MemoryMax=512M

[Install]
WantedBy=multi-user.target
