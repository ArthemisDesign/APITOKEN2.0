# Unified stateless router blue-green slot. The instance name is the fixed loopback port
# (8800 or 8801); deploy/router-bluegreen.sh is the sole lifecycle owner.
[Unit]
Description=claude-api unified router slot on port %i
After=network-online.target
Wants=network-online.target

[Service]
Slice=claude-router.slice
Type=simple
User=deploy
Group=deploy
# Argv-level assignments cannot be overridden by a shared EnvironmentFile.
ExecStart=/usr/bin/env CLAUDE_ROUTER_BODY_SPOOL_ROOT=/var/lib/apitoken/spool/router-%i CLAUDE_ROUTER_MAX_BODY_MIB=256 CLAUDE_ROUTER_BODY_MEMORY_BUDGET_MIB=4096 CLAUDE_ROUTER_BODY_SPOOL_BUDGET_MIB=16384 CLAUDE_ROUTER_BODY_MEMORY_THRESHOLD_MIB=8 CLAUDE_ROUTER_BODY_IDLE_SECS=120 CLAUDE_ROUTER_BODY_MAX_SECS=1800 CLAUDE_ROUTER_HOST=127.0.0.1 CLAUDE_ROUTER_PORT=%i CLAUDE_ROUTER_KIMI_ORIGIN=http://127.0.0.1:8803 /srv/claude-api/releases/current/claude-router
Restart=on-failure
RestartSec=1
KillSignal=SIGTERM
KillMode=mixed
# Caddy removes this slot before stop. Axum then stops accepting direct connections and lets
# already-established SSE streams finish within the same bounded drain used by provider slots.
TimeoutStopSec=660
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
StateDirectory=apitoken/spool/router-%i
StateDirectoryMode=0700
LimitNOFILE=262144
TasksMax=8192
OOMPolicy=stop
ReadWritePaths=/var/lib/apitoken/spool/router-%i
MemoryHigh=6G
MemoryMax=8G

[Install]
WantedBy=multi-user.target
