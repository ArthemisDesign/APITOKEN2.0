[Unit]
Description=Staging admin panel
After=apitoken-api-stage@3000.service
ConditionPathIsMountPoint=/var/lib/apitoken-staging
ConditionPathExists=/opt/apitoken-staging/admin-releases/current/apps/admin/node_modules/.bin/next
ConditionFileNotEmpty=/etc/apitoken-staging/admin.env

[Service]
Type=simple
User=deploy-stage
Group=deploy-stage
Slice=staging.slice
NetworkNamespacePath=/run/netns/apitoken-stage
WorkingDirectory=/opt/apitoken-staging/admin-releases/current/apps/admin
EnvironmentFile=/etc/apitoken-staging/admin.env
ExecStart=/opt/apitoken-staging/admin-releases/current/apps/admin/node_modules/.bin/next start -H 127.0.0.1 -p 3700
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
MemoryMax=1G

[Install]
WantedBy=staging.slice
