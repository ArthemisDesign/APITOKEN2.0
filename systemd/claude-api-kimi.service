# PostgreSQL-fenced backend-only KIMI surface backed by encrypted paid KIMI subscription profiles.
# This singleton is the legacy/anchor incarnation bound to the first slot port (8804): it exists so
# the first handoff and a rollback to a release predating the slot template always have a unit to
# run; steady state serves from claude-api-kimi@8804/8805 behind the stable 127.0.0.1:8803 origin.
[Unit]
Description=claude-api isolated KIMI subscription-pool provider
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
Environment=SUB_CFG_DIR=/srv/claude-api/data
EnvironmentFile=-/srv/claude-api/data/config.env
EnvironmentFile=-/srv/claude-api/data/server.env
EnvironmentFile=/srv/claude-api/data/engine-postgres.env
# Argv-level assignments cannot be overridden by a shared EnvironmentFile. CLAUDE_API_KIMI_ENABLED=1
# is pinned here on purpose: the plane's on/off state lives only in this reviewed unit, never in a
# shared config.env value. This enablement followed the live evidence of 2026-08-04 (owned Vivace
# subscription connected through Auth Bot; /me, /usages and an exactly metered generation proven —
# docs/engine/KIMI_PROVIDER.md). Disablement is the reverse reviewed unit change. The Anthropic
# plane keeps KIMI off so exactly one process ever runs the maintenance writer. Both ClaudeStore
# switches belong to other provider planes and must remain disabled here.
ExecStart=/usr/bin/env CLAUDE_API_BODY_SPOOL_ROOT=/run/claude-api-kimi CLAUDE_API_PROVIDER=kimi CLAUDE_API_CLAUDESTORE_FALLBACK_ENABLED=0 CLAUDE_API_CLAUDESTORE_CODEX_FALLBACK_ENABLED=0 CLAUDE_API_TRUST_LOOPBACK=0 CLAUDE_API_HOST=127.0.0.1 CLAUDE_API_PORT=8804 CLAUDE_API_INSTANCE_ID=%H:engine:kimi CLAUDE_API_KIMI_ENABLED=1 CLAUDE_API_TEXT_BODY_MAX_MIB=32 CLAUDE_API_BODY_MEMORY_BUDGET_MIB=2048 CLAUDE_API_BODY_SPOOL_BUDGET_MIB=2048 CLAUDE_API_BODY_MEMORY_THRESHOLD_MIB=32 CLAUDE_API_NONSTREAM_RESPONSE_MAX_MIB=64 /srv/claude-api/releases/current/claude-api serve
Restart=on-failure
RestartSec=3
KillSignal=SIGTERM
KillMode=mixed
TimeoutStopSec=720
UMask=0077
LimitCORE=0
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RuntimeDirectory=claude-api-kimi
RuntimeDirectoryMode=0700
ReadWritePaths=/run/claude-api-kimi
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
ReadWritePaths=/srv/claude-api/data
# Sealed roster generations and encrypted credential envelopes are atomically provisioned by Auth
# Bot; the gateway only decrypts them in memory and never exposes account identity. Provisioning
# creates this layout before runtime start. Absence fails the unit closed; otherwise an optional
# bind skipped at startup could become writable when the directory appears. The roster directory
# stays read-only EXCEPT credentials/: the rotating refresh family legally requires the runtime to
# atomically reseal the envelope after a won refresh, or every token expiry reads as auth death.
ReadOnlyPaths=/srv/claude-api/data/kimi
ReadWritePaths=/srv/claude-api/data/kimi/credentials
MemoryMax=2G

[Install]
WantedBy=multi-user.target
