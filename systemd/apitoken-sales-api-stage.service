[Unit]
Description=Staging sales API
Requires=apitoken-postgres-stage.service
After=apitoken-postgres-stage.service
ConditionPathIsMountPoint=/var/lib/apitoken-staging
ConditionPathExists=/opt/apitoken-staging/sales-releases/current/apps/sales-api/dist/main.js
ConditionFileNotEmpty=/etc/apitoken-staging/sales-api.env

[Service]
Type=simple
User=deploy-stage
Group=deploy-stage
Slice=staging.slice
NetworkNamespacePath=/run/netns/apitoken-stage
WorkingDirectory=/opt/apitoken-staging/sales-releases/current/apps/sales-api
EnvironmentFile=/etc/apitoken-staging/sales-api.env
ExecStart=/usr/bin/node --enable-source-maps dist/main.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
MemoryMax=1G

[Install]
WantedBy=staging.slice
