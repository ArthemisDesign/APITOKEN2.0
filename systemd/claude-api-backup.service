# Consistent custom-format dumps of commerce and (when provisioned) engine PostgreSQL databases.
[Unit]
Description=claude-api — consistent PostgreSQL backup
Requires=docker.service
After=docker.service network.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/apitoken/repo/deploy/apitoken-db-dump
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/apitoken/backups
