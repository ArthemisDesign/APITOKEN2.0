# Consistent custom-format dumps of commerce and (when provisioned) engine PostgreSQL databases.
[Unit]
Description=claude-api — consistent PostgreSQL backup
Requires=docker.service
After=docker.service network.target

[Service]
Type=oneshot
User=root
Group=root
RuntimeDirectory=apitoken-db-backup
RuntimeDirectoryMode=0700
Environment=HOME=/run/apitoken-db-backup
Environment=DOCKER_CONFIG=/run/apitoken-db-backup
ExecStart=/usr/local/lib/apitoken-watchdog/apitoken-db-dump
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/apitoken/backups
